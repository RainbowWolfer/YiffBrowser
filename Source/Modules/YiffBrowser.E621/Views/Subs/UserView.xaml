<UserControl
	x:Class="YiffBrowser.E621.Views.Subs.UserView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:Background="LightGray"
	d:DataContext="{d:DesignInstance Type=local:UserViewModel}"
	DataContext="{b:DISource Type=local:UserViewModel}"
	Width="240"
	Height="auto"
	mc:Ignorable="d">

	<Control.Resources>

	</Control.Resources>

	<Grid>
		<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}" Margin="2">

			<StackPanel>
				<bf:HorizontalIconText Margin="4,2" Glyph="&#xE723;" Text="User ID"/>
				<TextBox IsReadOnly="True" Text="{Binding User.Id, Mode=OneWay}"/>
			</StackPanel>

			<StackPanel>
				<bf:HorizontalIconText Margin="4,2" Glyph="&#xE8D4;" Text="Username"/>
				<TextBox IsReadOnly="True" Text="{Binding User.Name, Mode=OneWay}"/>
			</StackPanel>

			<StackPanel>
				<bf:HorizontalIconText Margin="4,2" Glyph="&#xE715;" Text="Email"/>
				<TextBox IsReadOnly="True" Text="{Binding User.Email, Mode=OneWay}"/>
			</StackPanel>

			<Grid>
				<Button
					Style="{DynamicResource ButtonPrimary}"
					Height="20"
					Margin="0,4,0,0"
					Padding="0"
					HorizontalAlignment="Stretch"
					Command="{Binding LogoutCommand}">
					<TextBlock Text="Logout"/>
				</Button>
			</Grid>

		</wpf:SpacingStackPanel>
	</Grid>

</UserControl>
