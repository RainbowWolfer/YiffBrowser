<UserControl
	x:Class="YiffBrowser.E621.Views.Subs.SearchView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:SearchViewModel}"
	d:DesignHeight="250"
	d:DesignWidth="200"
	DataContext="{b:DISource Type=local:SearchViewModel}"
	mc:Ignorable="d">

	<Control.Resources>

		<!--<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>-->

		<wpf:CommandProxy x:Key="HandleItemCommand" Command="{Binding HandleItemCommand}"/>
		<wpf:CommandProxy x:Key="QuickTagsCommand" Command="{Binding QuickTagsCommand}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:DispatcherServiceEx/>
		<b:LoadedService Command="{Binding LoadedCommand}"/>
	</dxmvvm:Interaction.Behaviors>

	<Grid>
		<StackPanel>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="auto"/>
				</Grid.ColumnDefinitions>

				<bf:TextBoxExtend x:Name="SearchBox"
					Style="{StaticResource TextBoxPlusBaseStyle}"
					bf:TextBoxExtension.SelectionChangedCommand="{Binding OnSearchTextSelectionChangedCommand}"
					hc:InfoElement.ShowClearButton="True"
					wpf:ControlExtension.LoadedCommand="{Binding OnSearchTextBoxLoadedCommand}"
					wpf:ControlExtension.PreviewKeyDownCommand="{Binding OnSearchTextBoxPreviewKeyDownCommand}"
					AcceptsReturn="False"
					AcceptsTab="False"
					BindableSelectionStart="{Binding TagsSearchService.SearchTextSelectionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Text="{Binding TagsSearchService.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<dxmvvm:Interaction.Behaviors>
						<b:TypedUIObjectService Name="SearchBoxService"/>
					</dxmvvm:Interaction.Behaviors>
				</bf:TextBoxExtend>

				<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" Grid.Column="1" Margin="4,0,0,0">

					<!--<Button
						Style="{StaticResource Button.Custom.Icon}"
						Width="30"
						Padding="0"
						Command="{Binding TagsSearchService.ClearCommand}"
						DockPanel.Dock="Right"
						ToolTip="Clear">
						<wpf:FontIcon Text="&#xE711;"/>
					</Button>-->

					<Button
						Style="{StaticResource Button.Custom.Icon}"
						Width="30"
						Padding="0"
						Command="{Binding SubmitCommand}"
						DockPanel.Dock="Right"
						ToolTip="Search">
						<wpf:FontIcon Text="&#xE721;"/>
					</Button>

					<wpf:MenuButton
						Style="{StaticResource Button.Custom.Icon}"
						Width="30"
						Padding="0"
						DockPanel.Dock="Right"
						ToolTip="Quick Search">
						<wpf:FontIcon Text="&#xE70D;"/>

						<wpf:MenuButton.ContextMenu>
							<ContextMenu Style="{DynamicResource ContextMenu.Custom}" ItemsSource="{Binding QuickTagsItems}">
								<ContextMenu.ItemContainerStyle>
									<Style TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Custom}">
										<Setter Property="Header" Value="{Binding Tags}"/>
										<Setter Property="Command" Value="{StaticResource QuickTagsCommand}"/>
										<Setter Property="CommandParameter" Value="{Binding}"/>
									</Style>
								</ContextMenu.ItemContainerStyle>
							</ContextMenu>
						</wpf:MenuButton.ContextMenu>

					</wpf:MenuButton>

					<Border Style="{StaticResource HorizontalSeparator}"/>

					<Button
						Style="{StaticResource Button.Custom.Icon}"
						Width="30"
						Padding="0"
						Command="{Binding OpenSearchPanelCommand}"
						DockPanel.Dock="Right"
						ToolTip="Open Search Panel">
						<wpf:FontIcon Text="&#xE8A7;"/>
					</Button>

					<Button
						Style="{StaticResource Button.Custom.Icon}"
						Width="30"
						Padding="0"
						Command="{Binding OpenSearchHistoryPanelCommand}"
						DockPanel.Dock="Right"
						ToolTip="Open Search History Panel">
						<wpf:FontIcon Text="&#xE81C;"/>
					</Button>

				</wpf:SpacingStackPanel>

			</Grid>

			<Border>
				<Grid>
					<ListBox x:Name="MainListBox"
						Margin="0,4,0,0"
						Padding="2"
						bf:ListBoxExtension.ClickBlankToDeselect="True"
						bf:ListBoxExtension.EscapeToDeselect="True"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						SelectedItem="{Binding TagsSearchService.SelectedItem, Mode=TwoWay}"
						Visibility="{Binding TagsSearchService.AutoCompletes.Count, Converter={StaticResource IListToVisibilityConverter}}"
						ItemsSource="{Binding TagsSearchService.AutoCompletes}"
						d:ItemsSource="{d:SampleData ItemCount=3}">

						<dxmvvm:Interaction.Behaviors>
							<b:TypedUIObjectService Name="MainListBoxService"/>
						</dxmvvm:Interaction.Behaviors>

						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel/>
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>

						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.SearchTags}">
								<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
								<Setter Property="wpf:ControlExtension.MouseDoubleClickCommand" Value="{StaticResource HandleItemCommand}"/>
								<Setter Property="wpf:ControlExtension.MouseDoubleClickCommandParameter" Value="{Binding}"/>
								<Setter Property="wpf:ControlExtension.MouseDoubleClickCommandDirectParameter" Value="True"/>
							</Style>
						</ListBox.ItemContainerStyle>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<c:SearchTagItemControl AutoComplete="{Binding AutoComplete}" IsSelected="{Binding IsSelected, Mode=TwoWay}"/>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>

					<StackPanel>
						<ProgressBar
							Height="6"
							Margin="0,4,0,0"
							VerticalAlignment="Top"
							BorderThickness="0"
							IsIndeterminate="True"
							Visibility="{Binding TagsSearchService.IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}"/>

						<TextBlock
							Margin="0,4,0,0"
							VerticalAlignment="Top"
							FontSize="14"
							Text="{Binding TagsSearchService.AlternativeHintText}"
							TextAlignment="Center"
							Visibility="{Binding TagsSearchService.AlternativeHintText, Converter={StaticResource String2VisibilityConverter}}"/>

					</StackPanel>

				</Grid>
			</Border>
		</StackPanel>
	</Grid>

</UserControl>
