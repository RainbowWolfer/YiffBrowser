<UserControl
	x:Class="YiffBrowser.E621.Views.E621MainView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:enums="clr-namespace:YiffBrowser.E621.Enums"
	xmlns:ex="clr-namespace:YiffBrowser.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:i="clr-namespace:YiffBrowser.E621.Interfaces"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:subs="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:vm="clr-namespace:YiffBrowser.E621.ViewModels"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=vm:E621MainViewModel}"
	d:DesignHeight="650"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>

		<wpf:CommandProxy x:Key="CollapseDockPanelCommand" Command="{Binding CollapseDockPanelCommand}"/>
		<wpf:CommandProxy x:Key="ExpandDockPanelCommand" Command="{Binding ExpandDockPanelCommand}"/>
		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:TypedUIObjectService Name="UserControl"/>
		<b:DispatcherServiceEx/>
		<b:LoadedService Command="{Binding LoadedCommand}" OnlyOnce="True"/>

		<bf:AppSettingsDialogService/>
		<bf:DownloadDialogService/>
	</dxmvvm:Interaction.Behaviors>
	<Grid>
		<DockPanel>
			<local:MainRailView DockPanel.Dock="Left"/>

			<Border>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">
						<Grid.RowDefinitions>
							<RowDefinition Height="*" MinHeight="100"/>
							<RowDefinition x:Name="BottomRow"
								MaxHeight="600"
								ex:E621MainViewExtension.DockPanelShow="{Binding DockPanelManager.HasDockPanels}"
								ex:E621MainViewExtension.IsDockPanelCollapsed="{Binding IsDockPanelCollapsed}"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0">
							<bf:BoolContent d:Bool="False">
								<bf:BoolContent.Bool>
									<MultiBinding Converter="{StaticResource BooleanArr2BooleanOrConverter}">
										<Binding Path="Tabs.Count" Converter="{StaticResource IListToBoolReConverter}"/>
										<Binding Path="ShowTabsManage"/>
									</MultiBinding>
								</bf:BoolContent.Bool>
								<bf:BoolContent.TrueContent>
									<local:TabOverviewView/>
								</bf:BoolContent.TrueContent>
								<bf:BoolContent.FalseContent>
									<local:PostTabControlView/>
								</bf:BoolContent.FalseContent>
							</bf:BoolContent>
						</Grid>

						<local:MainDockView Grid.Row="1"/>

						<Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

						<GridSplitter
							Grid.Row="1"
							Height="20"
							Margin="0,0,40,0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top"
							wpf:ControlExtension.MouseDoubleClickCommand="{Binding DockPanelGridSplitterDoubleClickCommand}"
							Background="Transparent">

							<GridSplitter.Visibility>
								<MultiBinding Converter="{StaticResource BooleanArr2VisibilityConverter}">
									<Binding Path="DockPanelManager.HasDockPanels"/>
									<Binding Path="IsDockPanelCollapsed" Converter="{StaticResource Boolean2BooleanReConverter}"/>
								</MultiBinding>
							</GridSplitter.Visibility>

							<GridSplitter.ContextMenu>
								<ContextMenu>
									<MenuItem bf:IconExtension.Glyph="&#xE70D;" Command="{StaticResource CollapseDockPanelCommand}" Header="Collapse Panel"/>
									<MenuItem bf:IconExtension.Glyph="&#xE70E;" Command="{StaticResource ExpandDockPanelCommand}" Header="Expand Panel"/>
									<Separator/>
									<MenuItem bf:IconExtension.Glyph="&#xE8BB;" Command="{Binding Source={StaticResource ViewModel}, Path=Data.CloseAllDockPanelsCommand}" Header="Close All Panels"/>
								</ContextMenu>
							</GridSplitter.ContextMenu>

						</GridSplitter>

					</Grid>

					<local:MainStatusBarView Grid.Row="1"/>
				</Grid>
			</Border>
		</DockPanel>
	</Grid>

</UserControl>