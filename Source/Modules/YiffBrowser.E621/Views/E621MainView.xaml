<UserControl
	x:Class="YiffBrowser.E621.Views.E621MainView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:enums="clr-namespace:YiffBrowser.E621.Enums"
	xmlns:ex="clr-namespace:YiffBrowser.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:i="clr-namespace:YiffBrowser.E621.Interfaces"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:subs="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:E621MainViewModel}"
	d:DesignHeight="650"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>

		<Style x:Key="ButtonDynamicStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<wpf:CommandProxy x:Key="CloseTabCommand" Command="{Binding CloseTabCommand}"/>
		<wpf:CommandProxy x:Key="CloseDockPanelCommand" Command="{Binding CloseDockPanelCommand}"/>
		<wpf:CommandProxy x:Key="CollapseDockPanelCommand" Command="{Binding CollapseDockPanelCommand}"/>
		<wpf:CommandProxy x:Key="DockPanelTabItemHeaderDoubleClickCommand" Command="{Binding DockPanelTabItemHeaderDoubleClickCommand}"/>

		<wpf:CommandProxy x:Key="CloneTabCommand" Command="{Binding CloneTabCommand}"/>
		<wpf:CommandProxy x:Key="RefresgTabCommand" Command="{Binding RefreshTabCommand}"/>
		<wpf:CommandProxy x:Key="AppenSearchCommand" Command="{Binding AppendSearchCommand}"/>
		<wpf:CommandProxy x:Key="CloseAllTabsCommand" Command="{Binding CloseAllTabsCommand}"/>
		<wpf:CommandProxy x:Key="CloseAllBeforeTabsCommand" Command="{Binding CloseAllBeforeTabsCommand}"/>
		<wpf:CommandProxy x:Key="CloseAllAfterTabsCommand" Command="{Binding CloseAllAfterTabsCommand}"/>
		<wpf:CommandProxy x:Key="CloseAllOtherTabsCommand" Command="{Binding CloseAllOtherTabsCommand}"/>
		<wpf:CommandProxy x:Key="RestoreClosedTabsCommand" Command="{Binding RestoreClosedTabsCommand}"/>

		<wpf:CommandProxy x:Key="TabCardClickCommand" Command="{Binding TabCardClickCommand}"/>
		<wpf:CommandProxy x:Key="MoveTabToFrontCommand" Command="{Binding MoveTabToFrontCommand}"/>
		<wpf:CommandProxy x:Key="SelectTabCardCommand" Command="{Binding SelectTabCardCommand}"/>
		<wpf:CommandProxy x:Key="AddTabToBookmarksCommand" Command="{Binding AddTabToBookmarksCommand}"/>
		<wpf:CommandProxy x:Key="OpenBookmarkCommand" Command="{Binding OpenBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="DeleteBookmarkCommand" Command="{Binding DeleteBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="NewBookmarkFolderCommand" Command="{Binding NewBookmarkFolderCommand}"/>
		<wpf:CommandProxy x:Key="BeginRenameBookmarkCommand" Command="{Binding BeginRenameBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="ConfirmRenameBookmarkCommand" Command="{Binding ConfirmRenameBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="CancelRenameBookmarkCommand" Command="{Binding CancelRenameBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="BeginEditBookmarkCommand" Command="{Binding BeginEditBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="ConfirmEditBookmarkCommand" Command="{Binding ConfirmEditBookmarkCommand}"/>
		<wpf:CommandProxy x:Key="CancelEditBookmarkCommand" Command="{Binding CancelEditBookmarkCommand}"/>

		<Style x:Key="RecentClosedMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Custom}">
			<Setter Property="Header" Value="{Binding Header}"/>
			<Setter Property="Command" Value="{Binding Command}"/>
			<Setter Property="CommandParameter" Value="{Binding Parameter}"/>
			<Setter Property="ItemsSource" Value="{Binding Children}"/>
			<Setter Property="ItemContainerStyle" Value="{DynamicResource RecentClosedMenuItemStyle}"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSeparator}" Value="True">
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Focusable" Value="False"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="MenuItem">
								<Separator/>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:TypedUIObjectService Name="UserControl"/>
		<b:DispatcherServiceEx/>
		<b:LoadedService Command="{Binding LoadedCommand}" OnlyOnce="True"/>

		<bf:AppSettingsDialogService/>
		<bf:DownloadDialogService/>
	</dxmvvm:Interaction.Behaviors>

	<Grid>

		<DockPanel>
			<Border Padding="4" Background="{DynamicResource RegionBrush}" DockPanel.Dock="Left">
				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
						<Button x:Name="SiteButton"
							Style="{StaticResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Padding="0"
							ToolTip="Click to switch site">
							<Button.Background>
								<ImageBrush d:ImageSource="{StaticResource E621_PNG}" ImageSource="{Binding ViewParameter.ModuleType, Converter={StaticResource ModuleTypeIconConverter}}"/>
							</Button.Background>
						</Button>

						<Border Style="{StaticResource VerticalSeparator}"/>

						<Button x:Name="SearchButton"
							Style="{DynamicResource Button.Custom.Icon.Vertical.Primary}"
							Width="32"
							Height="32"
							ToolTip="Search">
							<wpf:FontIcon Text="&#xE721;"/>
						</Button>

						<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Command="{Binding OpenTagsManagementPanelCommand}"
							ToolTip="Open Tags Management Panel">
							<wpf:FontIcon Text="&#xE912;"/>
						</Button>

						<Border Style="{StaticResource VerticalSeparator}"/>

						<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Command="{Binding OpenDownloadCommand}"
							ToolTip="Open Download Panel">
							<Grid Width="16" Height="16">
								<wpf:FontIcon Text="&#xE896;">
									<wpf:FontIcon.Style>
										<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource {x:Type wpf:FontIcon}}">
											<Setter Property="Opacity" Value="1"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsDownloadButtonFeedbackActive}" Value="True">
													<Setter Property="Opacity" Value="0"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</wpf:FontIcon.Style>
								</wpf:FontIcon>
								<wpf:FontIcon RenderTransformOrigin="0.5,0.5" Text="&#xE73E;">
									<wpf:FontIcon.RenderTransform>
										<ScaleTransform ScaleX="1" ScaleY="1"/>
									</wpf:FontIcon.RenderTransform>
									<wpf:FontIcon.Style>
										<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource {x:Type wpf:FontIcon}}">
											<Setter Property="Opacity" Value="0"/>
											<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsDownloadButtonFeedbackActive}" Value="True">
													<Setter Property="Opacity" Value="1"/>
													<DataTrigger.EnterActions>
														<BeginStoryboard>
															<Storyboard RepeatBehavior="3x">
																<DoubleAnimation
																	Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
																	From="0.7"
																	To="1.2"
																	AutoReverse="True"
																	Duration="0:0:0.22">
																	<DoubleAnimation.EasingFunction>
																		<QuadraticEase EasingMode="EaseOut"/>
																	</DoubleAnimation.EasingFunction>
																</DoubleAnimation>
																<DoubleAnimation
																	Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
																	From="0.7"
																	To="1.2"
																	AutoReverse="True"
																	Duration="0:0:0.22">
																	<DoubleAnimation.EasingFunction>
																		<QuadraticEase EasingMode="EaseOut"/>
																	</DoubleAnimation.EasingFunction>
																</DoubleAnimation>
															</Storyboard>
														</BeginStoryboard>
													</DataTrigger.EnterActions>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</wpf:FontIcon.Style>
								</wpf:FontIcon>
							</Grid>
						</Button>

						<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							ToolTip="Open Subscription Panel">
							<wpf:FontIcon Text="&#xE728;"/>
						</Button>

					</wpf:SpacingStackPanel>

					<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}" Grid.Row="1">

						<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Command="{Binding SwitchThemeCommand}"
							ToolTip="Switch Theme">
							<wpf:FontIcon Text="&#xF08C;"/>
						</Button>

						<Button x:Name="UserButton"
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							ToolTip="User">
							<Grid>
								<wpf:FontIcon d:Text="&#xEA8C;" Visibility="{Binding UserService.IsUserLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
									<wpf:FontIcon.Style>
										<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource FontIconBase}">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
													<Setter Property="Text" Value="&#xEA8C;"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
													<Setter Property="Text" Value="&#xE77B;"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</wpf:FontIcon.Style>
								</wpf:FontIcon>
								<Border Visibility="{Binding UserService.IsUserLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
									<!--<ProgressBar
										Width="20"
										Height="8"
										BorderThickness="0"
										Background="White"
										IsIndeterminate="True"/>-->
									<hc:CircleProgressBar Width="20" Height="20" IsIndeterminate="True"/>
								</Border>
							</Grid>
						</Button>

						<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Command="{Binding ShowAppSettingsDialogCommand}"
							ToolTip="Settings">
							<wpf:FontIcon Text="&#xE713;"/>
						</Button>

						<!--<Button
							Style="{DynamicResource Button.Custom.Icon.Vertical}"
							Width="32"
							Height="32"
							Command="{Binding ShowAppSettingsDialogCommand}"
							ToolTip="About">
							<wpf:FontIcon Text="&#xE946;"/>
						</Button>-->

						<StackPanel TextBlock.Foreground="{DynamicResource PrimaryTextBrush}">
							<!-- Text="{Binding Source={x:Static bf:AppConfig.Version}}" -->
							<TextBlock
								d:Text="1.0.0"
								FontSize="10"
								Text="{Binding AppManager.AppVersion.ShortVersion}"
								TextAlignment="Center"/>
							<TextBlock
								FontSize="10"
								Text="Debug"
								TextAlignment="Center"
								Visibility="{Binding Source={x:Static bf:AppConfig.IsRelease}, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
						</StackPanel>

					</wpf:SpacingStackPanel>

				</Grid>
			</Border>

			<Border>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">

						<Grid.RowDefinitions>
							<RowDefinition Height="*" MinHeight="100"/>
							<RowDefinition x:Name="BottomRow"
								MaxHeight="600"
								local:E621MainViewExtension.DockPanelShow="{Binding DockPanelManager.HasDockPanels}"
								local:E621MainViewExtension.IsDockPanelCollapsed="{Binding IsDockPanelCollapsed}"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0">

							<bf:BoolContent d:Bool="False">
								<bf:BoolContent.Bool>
									<MultiBinding Converter="{StaticResource BooleanArr2BooleanOrConverter}">
										<Binding Path="Tabs.Count" Converter="{StaticResource IListToBoolReConverter}"/>
										<Binding Path="ShowTabsManage"/>
									</MultiBinding>
								</bf:BoolContent.Bool>

								<bf:BoolContent.TrueContent>
									<Border BorderThickness="1,1,0,1" BorderBrush="{DynamicResource BorderBrush}">
										<DockPanel>

											<Border
												Padding="4"
												BorderThickness="0,0,0,1"
												BorderBrush="{DynamicResource BorderBrush}"
												DockPanel.Dock="Top">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="auto"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="auto"/>
													</Grid.ColumnDefinitions>

													<wpf:SpacingStackPanel Style="{DynamicResource CustomHorizontalPanel2}" Grid.Column="0">
														<Button Command="{Binding BackToTabsCommand}" Content="Back"/>
														<ToggleButton IsChecked="{Binding IsTabsManageSelecting, Mode=TwoWay}" ToolTip="Toggle selection mode">
															<wpf:FontIcon Text="&#xE762;"/>
														</ToggleButton>
													</wpf:SpacingStackPanel>

													<wpf:SpacingStackPanel Style="{DynamicResource CustomHorizontalPanel2}" Grid.Column="2">
														<ToggleButton IsChecked="{Binding ShowBookmarksPanel, Mode=TwoWay}" ToolTip="Toggle bookmarks panel">
															<wpf:FontIcon Text="&#xE8A5;"/>
														</ToggleButton>
													</wpf:SpacingStackPanel>

												</Grid>
											</Border>

											<Border>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="{Binding BookmarksPanelWidth}"/>
													</Grid.ColumnDefinitions>

													<Border Grid.Column="0">
														<hc:ScrollViewer hc:ScrollViewerAttach.AutoHide="False">
															<ItemsControl
																dd:DragDrop.IsDragSource="True"
																dd:DragDrop.IsDropTarget="True"
																dd:DragDrop.UseDefaultDragAdorner="True"
																ItemsSource="{Binding Tabs}"
																d:ItemsSource="{d:SampleData ItemCount=15}">

																<ItemsControl.ItemsPanel>
																	<ItemsPanelTemplate>
																		<wpf:SpacingStackPanel
																			Margin="4"
																			ChildWrapping="True"
																			HorizontalSpacing="4"
																			Orientation="Horizontal"
																			VerticalSpacing="4"/>
																	</ItemsPanelTemplate>
																</ItemsControl.ItemsPanel>

																<ItemsControl.ItemTemplate>
																	<DataTemplate>
																		<Button
																			Width="200"
																			Height="220"
																			Padding="0"
																			HorizontalContentAlignment="Stretch"
																			VerticalContentAlignment="Stretch"
																			Command="{StaticResource TabCardClickCommand}"
																			CommandParameter="{Binding}">

																			<Button.Style>
																				<Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
																					<Setter Property="BorderThickness" Value="1"/>
																					<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
																					<Style.Triggers>
																						<DataTrigger Binding="{Binding IsManageSelected}" Value="True">
																							<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
																							<Setter Property="BorderThickness" Value="2"/>
																						</DataTrigger>
																					</Style.Triggers>
																				</Style>
																			</Button.Style>

																			<Button.ContextMenu>
																				<ContextMenu>
																					<MenuItem Command="{StaticResource CloseTabCommand}" CommandParameter="{Binding}" Header="Close"/>
																					<MenuItem Command="{StaticResource CloneTabCommand}" CommandParameter="{Binding}" Header="Clone"/>
																					<MenuItem Command="{StaticResource RefresgTabCommand}" CommandParameter="{Binding}" Header="Refresh"/>
																					<MenuItem Command="{StaticResource MoveTabToFrontCommand}" CommandParameter="{Binding}" Header="Move to Front"/>
																					<Separator/>
																					<MenuItem Command="{StaticResource SelectTabCardCommand}" CommandParameter="{Binding}" Header="Select"/>
																					<MenuItem Command="{StaticResource AddTabToBookmarksCommand}" CommandParameter="{Binding}" Header="Add to Bookmarks"/>
																				</ContextMenu>
																			</Button.ContextMenu>

																			<Grid>
																				<Grid.RowDefinitions>
																					<RowDefinition Height="auto"/>
																					<RowDefinition Height="*"/>
																				</Grid.RowDefinitions>

																				<wpf:ClippingBorder
																					Grid.Row="0"
																					BorderThickness="0,0,0,1"
																					BorderBrush="{DynamicResource BorderBrush}"
																					Background="{DynamicResource SecondaryRegionBrush}">
																					<DockPanel>
																						<Border
																							MinWidth="20"
																							VerticalAlignment="Stretch"
																							BorderThickness="1,0,0,0"
																							BorderBrush="{DynamicResource BorderBrush}"
																							Background="{DynamicResource ThirdlyRegionBrush}"
																							DockPanel.Dock="Right">
																							<TextBlock
																								Margin="4,0"
																								VerticalAlignment="Center"
																								DockPanel.Dock="Right"
																								FontSize="11"
																								Opacity="0.8"
																								Text="{Binding CurrentPage, StringFormat=P{0}}"/>
																						</Border>
																						<TextBlock
																							Margin="4,2"
																							VerticalAlignment="Center"
																							Text="{Binding Tags, Converter={StaticResource TagsDisplayConverter}}"
																							TextTrimming="CharacterEllipsis"/>
																					</DockPanel>
																				</wpf:ClippingBorder>

																				<Border Grid.Row="1" Background="{DynamicResource ThirdlyRegionBrush}">
																					<ItemsControl ItemsSource="{Binding CoverPreviewUrls}">
																						<ItemsControl.ItemsPanel>
																							<ItemsPanelTemplate>
																								<UniformGrid Columns="2" Rows="2"/>
																							</ItemsPanelTemplate>
																						</ItemsControl.ItemsPanel>
																						<ItemsControl.ItemTemplate>
																							<DataTemplate>
																								<Border Margin="0.5" Background="{DynamicResource SecondaryRegionBrush}">
																									<Border Visibility="{Binding Source={x:Static bf:AppConfig.SafeMode}, Converter={StaticResource Boolean2VisibilityReConverter}}">
																										<Border.Background>
																											<ImageBrush
																												d:ImageSource="{StaticResource Temp1_JPG}"
																												AlignmentX="Center"
																												AlignmentY="Center"
																												ImageSource="{Binding}"
																												Stretch="UniformToFill"/>
																										</Border.Background>
																									</Border>
																								</Border>
																							</DataTemplate>
																						</ItemsControl.ItemTemplate>
																					</ItemsControl>
																				</Border>

																			</Grid>
																		</Button>
																	</DataTemplate>
																</ItemsControl.ItemTemplate>

															</ItemsControl>
														</hc:ScrollViewer>
													</Border>

													<Border
														Grid.Column="1"
														BorderThickness="1,0,0,0"
														BorderBrush="{DynamicResource BorderBrush}"
														Visibility="{Binding ShowBookmarksPanel, Converter={StaticResource Boolean2VisibilityConverter}}">
														<DockPanel>
															<Border
																Padding="4"
																BorderThickness="0,0,0,1"
																BorderBrush="{DynamicResource BorderBrush}"
																DockPanel.Dock="Top">
																<wpf:SpacingStackPanel Style="{DynamicResource CustomHorizontalPanel2}">
																	<Button Padding="4,2" Command="{Binding NewBookmarkFolderCommand}" ToolTip="New Folder">
																		<wpf:FontIcon Text="&#xE8F4;"/>
																	</Button>
																	<Button Padding="4,2" Command="{Binding DeleteBookmarkCommand}" ToolTip="Delete selected">
																		<wpf:FontIcon Text="&#xE74D;"/>
																	</Button>
																	<Button Padding="4,2" Command="{Binding OpenBookmarkCommand}" ToolTip="Open selected bookmark as tab">
																		<wpf:FontIcon Text="&#xE8A5;"/>
																	</Button>
																</wpf:SpacingStackPanel>
															</Border>

															<TreeView
																Style="{StaticResource TreeView.Small}"
																BorderThickness="0"
																dd:DragDrop.DropHandler="{Binding BookmarkDropHandler}"
																dd:DragDrop.IsDragSource="True"
																dd:DragDrop.IsDropTarget="True"
																dd:DragDrop.UseDefaultDragAdorner="True"
																SelectedItemChanged="BookmarkTree_SelectedItemChanged"
																ItemsSource="{Binding BookmarkRoots}">
																<TreeView.ContextMenu>
																	<ContextMenu>
																		<MenuItem Command="{StaticResource NewBookmarkFolderCommand}" Header="New Folder"/>
																	</ContextMenu>
																</TreeView.ContextMenu>
																<TreeView.ItemTemplate>
																	<HierarchicalDataTemplate ItemsSource="{Binding Children}">
																		<Border x:Name="BookmarkRowRoot" Padding="0,1" Background="Transparent">
																			<Border.ContextMenu>
																				<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
																					<MenuItem
																						Command="{StaticResource OpenBookmarkCommand}"
																						CommandParameter="{Binding}"
																						Header="Open"
																						Visibility="{Binding IsBookmark, Converter={StaticResource Boolean2VisibilityConverter}}"/>
																					<MenuItem
																						Command="{StaticResource BeginEditBookmarkCommand}"
																						CommandParameter="{Binding}"
																						Header="Edit"
																						Visibility="{Binding IsBookmark, Converter={StaticResource Boolean2VisibilityConverter}}"/>
																					<MenuItem
																						Command="{StaticResource BeginRenameBookmarkCommand}"
																						CommandParameter="{Binding}"
																						Header="Rename"
																						Visibility="{Binding IsFolder, Converter={StaticResource Boolean2VisibilityConverter}}"/>
																					<MenuItem Command="{StaticResource NewBookmarkFolderCommand}" CommandParameter="{Binding}" Header="New Folder"/>
																					<Separator/>
																					<MenuItem Command="{StaticResource DeleteBookmarkCommand}" CommandParameter="{Binding}" Header="Delete"/>
																				</ContextMenu>
																			</Border.ContextMenu>

																			<Grid>
																				<StackPanel Orientation="Horizontal">
																					<wpf:FontIcon Margin="0,0,4,0" FontSize="12">
																						<wpf:FontIcon.Style>
																							<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource {x:Type wpf:FontIcon}}">
																								<Setter Property="Text" Value="&#xE8B7;"/>
																								<Style.Triggers>
																									<DataTrigger Binding="{Binding IsBookmark}" Value="True">
																										<Setter Property="Text" Value="&#xE8A5;"/>
																									</DataTrigger>
																								</Style.Triggers>
																							</Style>
																						</wpf:FontIcon.Style>
																					</wpf:FontIcon>
																					<TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
																				</StackPanel>

																				<wpf:CustomPopup
																					IsOpen="{Binding IsRenamePopupOpen, Mode=TwoWay}"
																					Placement="Bottom"
																					PlacementTarget="{Binding ElementName=BookmarkRowRoot}"
																					StaysOpen="True">
																					<Border Style="{DynamicResource ButtonPopupBorder}" MinWidth="220">
																						<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
																							<TextBlock Text="Rename Folder"/>
																							<TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"/>
																							<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Right">
																								<Button
																									Padding="8,2"
																									bf:ButtonPopupExtension.CloseOnClick="True"
																									Command="{StaticResource CancelRenameBookmarkCommand}"
																									CommandParameter="{Binding}"
																									Content="Cancel"/>
																								<Button
																									Padding="8,2"
																									bf:ButtonPopupExtension.CloseOnClick="True"
																									Command="{StaticResource ConfirmRenameBookmarkCommand}"
																									CommandParameter="{Binding}"
																									Content="Confirm"/>
																							</wpf:SpacingStackPanel>
																						</wpf:SpacingStackPanel>
																					</Border>
																				</wpf:CustomPopup>

																				<wpf:CustomPopup
																					IsOpen="{Binding IsEditPopupOpen, Mode=TwoWay}"
																					Placement="Bottom"
																					PlacementTarget="{Binding ElementName=BookmarkRowRoot}"
																					StaysOpen="True">
																					<Border Style="{DynamicResource ButtonPopupBorder}" MinWidth="260">
																						<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
																							<TextBlock Text="Edit Bookmark"/>
																							<TextBlock Opacity="0.75" Text="Tags"/>
																							<TextBox AcceptsReturn="False" Text="{Binding DraftTagsText, UpdateSourceTrigger=PropertyChanged}"/>
																							<TextBlock Opacity="0.75" Text="Page"/>
																							<hc:NumericUpDown Minimum="1" Value="{Binding DraftPage, UpdateSourceTrigger=PropertyChanged}"/>
																							<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Right">
																								<Button
																									Padding="8,2"
																									bf:ButtonPopupExtension.CloseOnClick="True"
																									Command="{StaticResource CancelEditBookmarkCommand}"
																									CommandParameter="{Binding}"
																									Content="Cancel"/>
																								<Button
																									Padding="8,2"
																									bf:ButtonPopupExtension.CloseOnClick="True"
																									Command="{StaticResource ConfirmEditBookmarkCommand}"
																									CommandParameter="{Binding}"
																									Content="Confirm"/>
																							</wpf:SpacingStackPanel>
																						</wpf:SpacingStackPanel>
																					</Border>
																				</wpf:CustomPopup>
																			</Grid>
																		</Border>
																	</HierarchicalDataTemplate>
																</TreeView.ItemTemplate>
																<TreeView.ItemContainerStyle>
																	<Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItemBaseStyle.Small}">
																		<EventSetter Event="MouseDoubleClick" Handler="BookmarkTree_MouseDoubleClick"/>
																		<Setter Property="IsExpanded" Value="True"/>
																		<Setter Property="Padding" Value="2"/>
																	</Style>
																</TreeView.ItemContainerStyle>
															</TreeView>
														</DockPanel>
													</Border>

													<GridSplitter
														Width="1"
														HorizontalAlignment="Right"
														VerticalAlignment="Stretch"
														Background="{DynamicResource BorderBrush}"
														Visibility="{Binding ShowBookmarksPanel, Converter={StaticResource Boolean2VisibilityConverter}}"/>
												</Grid>
											</Border>

										</DockPanel>
									</Border>
								</bf:BoolContent.TrueContent>

								<bf:BoolContent.FalseContent>
									<Border Visibility="{Binding Tabs.Count, Converter={StaticResource IListToVisibilityConverter}}">
										<c:TabControlEx
											Style="{StaticResource TabControl.Custom.Main}"
											Margin="0"
											Padding="0"
											BorderThickness="0,0,0,0"
											BorderBrush="{DynamicResource BorderBrush}"
											dd:DragDrop.IsDragSource="True"
											dd:DragDrop.IsDropTarget="True"
											Background="{DynamicResource RegionBrush}"
											SelectedIndex="{Binding TabSelectedIndex, Mode=TwoWay}"
											TabStripPlacement="{Binding ViewConfigService.TabDock}"
											TabsManageCommand="{Binding TabsManageCommand}"
											ItemsSource="{Binding Tabs}"
											d:ItemsSource="{d:SampleData ItemCount=15}">

											<c:TabControlEx.TabListItemTemplate>
												<DataTemplate>
													<DockPanel>
														<hc:CircleProgressBar
															Width="14"
															Height="14"
															Margin="0,0,4,0"
															ArcThickness="2"
															IsIndeterminate="True"
															Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}"/>
														<TextBlock VerticalAlignment="Center" Text="{Binding Tags, Converter={StaticResource TagsDisplayConverter}}"/>
													</DockPanel>
												</DataTemplate>
											</c:TabControlEx.TabListItemTemplate>

											<c:TabControlEx.HeaderContextMenu>
												<ContextMenu>
													<MenuItem bf:IconExtension.Glyph="" Command="{StaticResource CloseAllTabsCommand}" Header="Close All"/>

													<MenuItem Header="Recent Closed Tabs" ItemContainerStyle="{StaticResource RecentClosedMenuItemStyle}" ItemsSource="{Binding Source={StaticResource ViewModel}, Path=Data.RecentClosedMenuItems}"/>

													<Separator/>

													<MenuItem bf:IconExtension.Glyph="&#xE75A;" Header="Tab Docks">
														<MenuItem Header="Top" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Top}"/>

														<MenuItem Header="Left" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Left}"/>

														<MenuItem Header="Bottom" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bottom}"/>

														<MenuItem Header="Right" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Right}"/>
													</MenuItem>

												</ContextMenu>
											</c:TabControlEx.HeaderContextMenu>

											<TabControl.ItemContainerStyle>
												<Style TargetType="TabItem" BasedOn="{StaticResource TabItem.Custom.Main}">
													<Setter Property="MinHeight" Value="0"/>
													<Setter Property="ContextMenu">
														<Setter.Value>
															<ContextMenu>
																<!--<MenuItem bf:IconExtension.Glyph="&#xECC8;" Header="New Tab"/>-->
																<MenuItem
																	bf:IconExtension.Glyph="&#xE70A;"
																	Command="{StaticResource CloneTabCommand}"
																	CommandParameter="{Binding}"
																	Header="Clone Tab"/>

																<Separator/>

																<MenuItem
																	bf:IconExtension.Glyph="&#xE72C;"
																	Command="{StaticResource RefresgTabCommand}"
																	CommandParameter="{Binding}"
																	Header="Refresh"/>
																<MenuItem
																	bf:IconExtension.Glyph="&#xE721;"
																	Command="{StaticResource AppenSearchCommand}"
																	CommandParameter="{Binding}"
																	Header="Append Search"/>

																<Separator/>

																<MenuItem
																	bf:IconExtension.Glyph="&#xE711;"
																	Command="{StaticResource CloseTabCommand}"
																	CommandParameter="{Binding}"
																	Header="Close"/>
																<MenuItem
																	bf:IconExtension.Glyph=""
																	Command="{StaticResource CloseAllTabsCommand}"
																	CommandParameter="{Binding}"
																	Header="Close All"/>
																<MenuItem
																	bf:IconExtension.Glyph=""
																	Command="{StaticResource CloseAllBeforeTabsCommand}"
																	CommandParameter="{Binding}"
																	Header="Close All Before"/>
																<MenuItem
																	bf:IconExtension.Glyph=""
																	Command="{StaticResource CloseAllAfterTabsCommand}"
																	CommandParameter="{Binding}"
																	Header="Close All After"/>
																<MenuItem
																	bf:IconExtension.Glyph=""
																	Command="{StaticResource CloseAllOtherTabsCommand}"
																	CommandParameter="{Binding}"
																	Header="Close Others"/>

																<Separator/>

																<MenuItem Header="Recent Closed Tabs" ItemContainerStyle="{StaticResource RecentClosedMenuItemStyle}" ItemsSource="{Binding Source={StaticResource ViewModel}, Path=Data.RecentClosedMenuItems}"/>

																<Separator/>

																<MenuItem bf:IconExtension.Glyph="&#xE75A;" Header="Tab Docks">
																	<MenuItem Header="Top" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static Dock.Top}}"/>

																	<MenuItem Header="Left" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static Dock.Left}}"/>

																	<MenuItem Header="Bottom" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static Dock.Bottom}}"/>

																	<MenuItem Header="Right" IsCheckable="True" IsChecked="{Binding Source={StaticResource ViewModel}, Path=Data.ViewConfigService.TabDock, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static Dock.Right}}"/>
																</MenuItem>

															</ContextMenu>
														</Setter.Value>
													</Setter>
												</Style>
											</TabControl.ItemContainerStyle>

											<TabControl.ItemTemplate>
												<DataTemplate>
													<Grid MinWidth="100" Margin="1">
														<DockPanel>

															<Border DockPanel.Dock="Left">
																<hc:CircleProgressBar
																	Width="12"
																	Height="12"
																	Margin="4,0,2,4"
																	VerticalAlignment="Bottom"
																	ArcThickness="2"
																	Foreground="{DynamicResource PrimaryTextBrush}"
																	IsIndeterminate="True"
																	Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}"/>
															</Border>

															<StackPanel Name="buttonPanel" DockPanel.Dock="Right" Visibility="Visible">
																<Button Name="CloseTabButton"
																	Style="{DynamicResource CustomButtonStyle.Danger}"
																	Width="14"
																	Height="14"
																	Margin="2,0,0,0"
																	Padding="2"
																	VerticalAlignment="Top"
																	BorderThickness="0"
																	Cursor="Hand"
																	ToolTip="Close this tab">
																	<wpf:FontIcon VerticalAlignment="Top" FontSize="10" Text="&#xE711;"/>
																</Button>
															</StackPanel>

															<!--<Rectangle Name="indicator"
																Width="3"
																Height="12"
																Margin="4,0,0,4"
																VerticalAlignment="Bottom"
																Fill="{DynamicResource PrimaryTextBrush}"
																RadiusX="1.5"
																RadiusY="1.5"/>-->

															<!--<Border Name="iconPanel" Margin="4,0,0,2" VerticalAlignment="Bottom">
																<wpf:FontIcon Text="&#xF157;"/>
															</Border>-->

															<TextBlock Margin="4,0,0,2" VerticalAlignment="Bottom" Text="{Binding Tags, Converter={StaticResource TagsDisplayConverter}}"/>
														</DockPanel>

														<wpf:ButtonPopup SourceButton="{Binding ElementName=CloseTabButton}">
															<Border Style="{DynamicResource ButtonPopupBorder}">
																<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
																	<TextBlock Text="Sure to close this tab?"/>
																	<Button
																		Padding="4,2"
																		bf:ButtonPopupExtension.CloseOnClick="True"
																		Command="{StaticResource CloseTabCommand}"
																		CommandParameter="{Binding}">
																		<TextBlock Text="Confirm"/>
																	</Button>
																</wpf:SpacingStackPanel>
															</Border>
														</wpf:ButtonPopup>
													</Grid>

													<DataTemplate.Triggers>

														<MultiDataTrigger>
															<MultiDataTrigger.Conditions>
																<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="False"/>
																<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsMouseOver}" Value="False"/>
															</MultiDataTrigger.Conditions>
															<Setter TargetName="buttonPanel" Property="Visibility" Value="Hidden"/>
														</MultiDataTrigger>

													</DataTemplate.Triggers>

												</DataTemplate>
											</TabControl.ItemTemplate>

											<TabControl.ContentTemplate>
												<DataTemplate>
													<!--<ContentControl Content="{Binding View}"/>-->
													<Border x:Name="PART_Border">
														<!--<local:PostsView dxmvvm:ViewModelExtensions.Parameter="{Binding ElementName=PART_Border, Path=DataContext}" dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}"/>-->
														<ContentControl
															Content="{Binding View}"
															Focusable="False"
															IsTabStop="False"
															Visibility="Visible"/>
													</Border>
												</DataTemplate>
											</TabControl.ContentTemplate>

										</c:TabControlEx>
									</Border>
								</bf:BoolContent.FalseContent>

							</bf:BoolContent>

						</Grid>

						<Border
							Grid.Row="1"
							BorderThickness="0,0,0,0"
							BorderBrush="{DynamicResource BorderBrush}"
							Visibility="{Binding DockPanelManager.HasDockPanels, Converter={StaticResource Boolean2VisibilityConverter}}">
							<Grid>
								<TabControl
									dd:DragDrop.IsDragSource="True"
									dd:DragDrop.IsDropTarget="True"
									SelectedItem="{Binding SelectedDockPanelItem}"
									TabStripPlacement="Bottom"
									ItemsSource="{Binding DockPanelManager.DockPanels}">

									<TabControl.Style>
										<Style TargetType="TabControl" BasedOn="{StaticResource TabControl.Custom.DockPanel}">
											<Setter Property="BorderThickness" Value="1,0,0,1"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsDockPanelCollapsed}" Value="True">
													<Setter Property="BorderThickness" Value="1,0,0,0"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TabControl.Style>

									<TabControl.ItemTemplate>
										<DataTemplate DataType="{x:Type i:IDockPanel}">
											<DockPanel>
												<wpf:FontIcon Margin="0,0,8,0" Text="{Binding Icon}"/>
												<TextBlock Text="{Binding Name}"/>
											</DockPanel>
										</DataTemplate>
									</TabControl.ItemTemplate>

									<TabControl.ItemContainerStyle>
										<Style TargetType="TabItem" BasedOn="{StaticResource TabItem.Custom.DockPanel}">
											<Setter Property="wpf:ControlExtension.MouseDoubleClickCommand" Value="{StaticResource DockPanelTabItemHeaderDoubleClickCommand}"/>
											<Setter Property="ContextMenu">
												<Setter.Value>
													<ContextMenu>
														<MenuItem Header="1"/>
														<MenuItem Header="2"/>
													</ContextMenu>
												</Setter.Value>
											</Setter>
										</Style>
									</TabControl.ItemContainerStyle>

									<TabControl.ContentTemplate>
										<DataTemplate DataType="{x:Type i:IDockPanel}">
											<Border Visibility="{Binding Source={StaticResource ViewModel}, Path=Data.IsDockPanelCollapsed, Converter={StaticResource Boolean2VisibilityReConverter}}">
												<DockPanel>
													<Border
														Height="20"
														BorderThickness="0,0,0,1"
														BorderBrush="{DynamicResource BorderBrush}"
														Background="{DynamicResource SecondaryRegionBrush}"
														DockPanel.Dock="Top">

														<Grid>
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="auto"/>
															</Grid.ColumnDefinitions>
															<Border Padding="6,0">
																<TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
															</Border>

															<StackPanel Grid.Column="1" Orientation="Horizontal">

																<Button
																	Width="20"
																	Height="20"
																	Padding="0"
																	BorderThickness="1,0,0,0"
																	hc:BorderElement.CornerRadius="0"
																	Command="{StaticResource CollapseDockPanelCommand}">
																	<wpf:FontIcon FontSize="10" Text="&#xE70D;"/>
																</Button>

																<Button
																	Width="20"
																	Height="20"
																	Padding="0"
																	BorderThickness="1,0,0,0"
																	hc:BorderElement.CornerRadius="0"
																	Command="{StaticResource CloseDockPanelCommand}"
																	CommandParameter="{Binding}">
																	<wpf:FontIcon FontSize="10" Text="&#xE8BB;"/>
																</Button>
															</StackPanel>

														</Grid>
													</Border>
													<ContentControl Content="{Binding Content}"/>
												</DockPanel>
											</Border>
										</DataTemplate>
									</TabControl.ContentTemplate>

								</TabControl>

								<StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
									<Button
										Width="30"
										Height="30"
										Padding="0"
										BorderThickness="1,0,0,0"
										hc:BorderElement.CornerRadius="0"
										Command="{Binding CloseAllDockPanelsCommand}">
										<wpf:FontIcon FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="&#xE8BB;"/>
									</Button>
								</StackPanel>
							</Grid>
						</Border>

						<Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}"/>

						<GridSplitter
							Grid.Row="1"
							Height="20"
							Margin="0,0,40,0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top"
							wpf:ControlExtension.MouseDoubleClickCommand="{Binding DockPanelGridSplitterDoubleClickCommand}"
							Background="Transparent">

							<GridSplitter.Visibility>
								<MultiBinding Converter="{StaticResource BooleanArr2VisibilityConverter}">
									<Binding Path="DockPanelManager.HasDockPanels"/>
									<Binding Path="IsDockPanelCollapsed" Converter="{StaticResource Boolean2BooleanReConverter}"/>
								</MultiBinding>
							</GridSplitter.Visibility>

							<GridSplitter.ContextMenu>
								<ContextMenu>
									<MenuItem Header="1"/>
									<MenuItem Header="2"/>
								</ContextMenu>
							</GridSplitter.ContextMenu>

						</GridSplitter>

					</Grid>

					<Border Grid.Row="1" Padding="6,4" Background="{DynamicResource SecondaryRegionBrush}">
						<Grid>
							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Margin" Value="0,0,20,0"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="{x:Static WindowState.Maximized}">
											<Setter Property="Margin" Value="0,0,2,0"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0">
								<TextBlock Text="Hint Info"/>
							</Border>

							<Border Grid.Column="2" HorizontalAlignment="Right">
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
									<Border
										Margin="0,0,8,0"
										Padding="8,2"
										VerticalAlignment="Center"
										Background="{DynamicResource PrimaryBrush}"
										CornerRadius="3">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Opacity" Value="0"/>
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding ShowDownloadAddedToast}" Value="True">
														<DataTrigger.EnterActions>
															<BeginStoryboard>
																<Storyboard>
																	<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
																		<DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
																	</ObjectAnimationUsingKeyFrames>
																	<DoubleAnimation
																		Storyboard.TargetProperty="Opacity"
																		From="0"
																		To="1"
																		Duration="0:0:0.28">
																		<DoubleAnimation.EasingFunction>
																			<QuadraticEase EasingMode="EaseOut"/>
																		</DoubleAnimation.EasingFunction>
																	</DoubleAnimation>
																</Storyboard>
															</BeginStoryboard>
														</DataTrigger.EnterActions>
														<DataTrigger.ExitActions>
															<BeginStoryboard>
																<Storyboard>
																	<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4">
																		<DoubleAnimation.EasingFunction>
																			<QuadraticEase EasingMode="EaseIn"/>
																		</DoubleAnimation.EasingFunction>
																	</DoubleAnimation>
																	<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
																		<DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Collapsed}"/>
																	</ObjectAnimationUsingKeyFrames>
																</Storyboard>
															</BeginStoryboard>
														</DataTrigger.ExitActions>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Foreground="White"
											Text="{Binding DownloadAddedToastText}"/>
									</Border>

									<Button
										Style="{StaticResource ButtonDefault.Small}"
										Padding="6,2"
										BorderThickness="0"
										Background="Transparent"
										Command="{Binding OpenDownloadCommand}"
										ToolTip="Open Download Manager">
										<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
											<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding DownloadService.OverallStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
												<TextBlock
													d:Text="3.2 MB/s"
													VerticalAlignment="Center"
													Foreground="{DynamicResource PrimaryTextBrush}"
													Opacity="0.75"
													Text="{Binding DownloadService.OverallStatus.SpeedText}"/>
												<TextBlock
													d:Text="45%"
													Margin="8,0,0,0"
													VerticalAlignment="Center"
													Foreground="{DynamicResource PrimaryTextBrush}"
													Text="{Binding DownloadService.OverallStatus.Progress, StringFormat={}{0:0}%, TargetNullValue=—}"/>
												<hc:CircleProgressBar
													Width="16"
													Height="16"
													Margin="8,0,0,0"
													wpf:ProgressBarExtension.Progress="{Binding DownloadService.OverallStatus.Progress}"
													ArcThickness="2"
													Background="{DynamicResource RegionBrush}"
													ShowText="False"/>
											</StackPanel>

											<wpf:FontIcon
												FontSize="12"
												Foreground="{DynamicResource PrimaryTextBrush}"
												Text="&#xE896;"
												Visibility="{Binding DownloadService.OverallStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
										</StackPanel>
									</Button>
								</StackPanel>
							</Border>

						</Grid>
					</Border>

				</Grid>

			</Border>
		</DockPanel>

		<wpf:ButtonPopup
			HorizontalOffset="8"
			Placement="Right"
			SourceButton="{Binding ElementName=UserButton}"
			StaysOpen="False">
			<wpf:ButtonPopup.Style>
				<Style TargetType="wpf:ButtonPopup">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
							<Setter Property="VerticalOffset" Value="-115"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
							<Setter Property="VerticalOffset" Value="-90"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</wpf:ButtonPopup.Style>
			<Border Style="{DynamicResource ButtonPopupBorder}">
				<Grid>
					<Border Visibility="{Binding IsLoggedIn, Converter={StaticResource Boolean2VisibilityReConverter}}">
						<subs:UserLogin ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
					</Border>
					<Border Visibility="{Binding IsLoggedIn, Converter={StaticResource Boolean2VisibilityConverter}}">
						<subs:UserView ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
					</Border>
				</Grid>
			</Border>
		</wpf:ButtonPopup>

		<!-- Placement="Right" HorizontalOffset="6" -->
		<wpf:ButtonPopup x:Name="SearchPopup"
			HorizontalOffset="0"
			Placement="Bottom"
			SourceButton="{Binding ElementName=SearchButton}"
			StaysOpen="False"
			VerticalOffset="4">
			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService Name="SearchPopupService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border Style="{DynamicResource ButtonPopupBorder}" MinWidth="380">
				<subs:SearchView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}" ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
			</Border>

		</wpf:ButtonPopup>

		<wpf:ButtonPopup x:Name="SitePopup"
			HorizontalOffset="8"
			Placement="Right"
			SourceButton="{Binding ElementName=SiteButton}">
			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService Name="SitePopupService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border Style="{DynamicResource ButtonPopupBorder}">
				<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">

					<Button
						Style="{StaticResource ButtonDynamicStyle}"
						Width="90"
						Height="40"
						Padding="4"
						HorizontalContentAlignment="Left"
						Command="{Binding ShowE621Command}"
						IsEnabled="{Binding ViewParameter.ModuleType, Converter={StaticResource EqualToBoolReConverter}, ConverterParameter={x:Static enums:ModuleType.E621}}">
						<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}">
							<Border Width="32" Height="32" CornerRadius="4">
								<Border.Background>
									<ImageBrush ImageSource="{Binding Source={x:Static enums:ModuleType.E621}, Converter={StaticResource ModuleTypeIconConverter}}"/>
								</Border.Background>
							</Border>
							<TextBlock
								FontSize="16"
								FontWeight="Bold"
								Foreground="#01549d"
								Text="E621"/>
						</wpf:SpacingStackPanel>
					</Button>

					<Button
						Style="{StaticResource ButtonDynamicStyle}"
						Width="90"
