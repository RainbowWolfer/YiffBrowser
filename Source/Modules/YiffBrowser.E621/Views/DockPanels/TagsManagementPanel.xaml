<UserControl
	x:Class="YiffBrowser.E621.Views.DockPanels.TagsManagementPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views.DockPanels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:TagsManagementPanelViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	DataContext="{b:DISource Type=local:TagsManagementPanelViewModel}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="300"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<TreeView
			Margin="2"
			Padding="6"
			BorderThickness="0"
			hc:ScrollViewerAttach.AutoHide="False">

			<TreeViewItem Header="Block List">
				<TreeViewItem Header="Collection 1"/>
				<TreeViewItem Header="Collection 2"/>
				<TreeViewItem Header="Collection 3"/>
			</TreeViewItem>

			<TreeViewItem Header="Highlight List">
				<TreeViewItem Header="Collection 1"/>
				<TreeViewItem Header="Collection 2"/>
				<TreeViewItem Header="Collection 3"/>
			</TreeViewItem>

			<TreeViewItem Header="Bookmark">
				<TreeViewItem Header="Collection 1"/>
				<TreeViewItem Header="Collection 2"/>
				<TreeViewItem Header="Collection 3"/>
			</TreeViewItem>

		</TreeView>

		<Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource BorderBrush}">

		</Border>

	</Grid>

</UserControl>
