<UserControl
	x:Class="YiffBrowser.E621.Views.PostsView"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c1="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:ex="clr-namespace:YiffBrowser.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="clr-namespace:YiffBrowser.E621.Models"
	xmlns:subs="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:PostsViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>

		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>

		<wpf:CommandProxy x:Key="ViewPostDetailCommand" Command="{Binding ViewPostDetailCommand}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>

	</dxmvvm:Interaction.Behaviors>

	<Grid>
		<DockPanel>

			<Border>
				<Grid>

					<Border Visibility="{Binding CurrentHasPost, Converter={StaticResource Boolean2VisibilityReConverter}}">
						<DockPanel>
							<Border Padding="4" Background="{DynamicResource RegionBrush}" DockPanel.Dock="Top">

								<Grid>
									<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Left">
										<Button Width="100">
											<Button.Background>
												<ImageBrush ImageSource="https://static1.e6ai.net/data/4e/41/4e410c6dd24c6470cd932326a821a0c9.png" Stretch="UniformToFill"/>
											</Button.Background>
										</Button>
									</wpf:SpacingStackPanel>

									<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Center" IsEnabled="{Binding IsLoading, Converter={StaticResource Boolean2BooleanReConverter}}">
										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding RefreshCommand}"
											ToolTip="Refresh">
											<wpf:FontIcon Text="&#xE72C;"/>
										</Button>

										<Border Style="{StaticResource HorizontalSeparator}"/>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding PreviousPageCommand}"
											IsEnabled="{Binding CanGoLeft}"
											ToolTip="Previous Page">
											<wpf:FontIcon Text="&#xE76B;"/>
										</Button>

										<Button x:Name="CurrentPageButton"
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											ToolTip="Current Page">
											<TextBlock d:Text="99" FontSize="16" Text="{Binding CurrentPage}"/>
										</Button>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding NextPageCommand}"
											ToolTip="Next Page">
											<wpf:FontIcon Text="&#xE76C;"/>
										</Button>

										<Border Style="{StaticResource HorizontalSeparator}"/>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding DownloadCommand}"
											ToolTip="Download">
											<wpf:FontIcon Text="&#xE896;"/>
										</Button>

										<ToggleButton Height="30" MinWidth="30" IsChecked="{Binding IsMultiSelecting, Mode=TwoWay}">
											<ToggleButton.ToolTip>
												<TextBlock Foreground="Black" Text="Toggle Selection"/>
											</ToggleButton.ToolTip>
											<bf:HorizontalIconText
												d:Text="(1/75)"
												Glyph="&#xE152;"
												IconForeground="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Foreground}"
												Text="{Binding MultiSelectingText}"/>
										</ToggleButton>

									</wpf:SpacingStackPanel>

								</Grid>

							</Border>

							<Border DockPanel.Dock="Top" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
								<ProgressBar Style="{StaticResource ProgressBarFlat}" Height="10" IsIndeterminate="True"/>
							</Border>

							<c1:PostCardListBox x:Name="PostsListBox"
								Padding="2"
								BorderThickness="0,1,0,0"
								BorderBrush="{DynamicResource BorderBrush}"
								bf:SelectorExtension.SelectedItems="{Binding SelectedItems}"
								AllowSelection="{Binding IsMultiSelecting}"
								Background="{DynamicResource RegionBrush}"
								VirtualizingPanel.IsVirtualizing="False"
								VirtualizingPanel.ScrollUnit="Pixel"
								ItemsSource="{Binding Items}"
								d:ItemsSource="{d:SampleData ItemCount=15}">

								<dxmvvm:Interaction.Behaviors>
									<b:TypedUIObjectService Name="PostsListBoxService"/>
								</dxmvvm:Interaction.Behaviors>

								<ItemsControl.Style>
									<Style TargetType="{x:Type bf:VariableSizedWrapGridView}">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="{x:Type bf:VariableSizedWrapGridView}">
													<Border
														BorderThickness="{TemplateBinding BorderThickness}"
														BorderBrush="{TemplateBinding BorderBrush}"
														Background="{TemplateBinding Background}"
														SnapsToDevicePixels="True">
														<hc:ScrollViewer Name="PART_ScrollViewer"
															Padding="{TemplateBinding Padding}"
															hc:ScrollViewerAttach.AutoHide="False"
															hc:ScrollViewerAttach.Orientation="Vertical"
															CanContentScroll="False"
															HorizontalScrollBarVisibility="Disabled"
															IsInertiaEnabled="True"
															VerticalScrollBarVisibility="Auto">
															<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
														</hc:ScrollViewer>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsMultiSelecting}" Value="True">
												<Setter Property="SelectionMode" Value="Multiple"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding IsMultiSelecting}" Value="False">
												<Setter Property="SelectionMode" Value="Single"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ItemsControl.Style>

								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<bf:VariableSizedWrapGrid
											HorizontalChildrenAlignment="Stretch"
											ItemHeight="{x:Static local:PostsViewModel.ItemHeight}"
											ItemWidth="{x:Static local:PostsViewModel.ItemWidth}"
											Orientation="Horizontal"
											VerticalChildrenAlignment="Stretch"
											VerticalScrollAmount="200"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemContainerStyle>
									<Style TargetType="ListBoxItem">
										<EventSetter Event="RequestBringIntoView" Handler="ListBoxItem_RequestBringIntoView"/>
										<Setter Property="bf:ListBoxItemClickExtension.ClickCommand" Value="{StaticResource ViewPostDetailCommand}"/>
										<Setter Property="bf:ListBoxItemClickExtension.ClickCommandParameter" Value="{Binding Post}"/>
										<Setter Property="Margin" Value="0"/>
										<Setter Property="Padding" Value="0"/>
										<Setter Property="BorderThickness" Value="3"/>
										<Setter Property="Padding" Value="2"/>
										<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="ListBoxItem">
													<Border Margin="{TemplateBinding Padding}">
														<ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" UseLayoutRounding="{TemplateBinding UseLayoutRounding}"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Setter Property="ContextMenu">
											<Setter.Value>
												<ContextMenu>
													<MenuItem Header="Open"/>
												</ContextMenu>
											</Setter.Value>
										</Setter>
									</Style>
								</ItemsControl.ItemContainerStyle>

							</c1:PostCardListBox>

						</DockPanel>
					</Border>

					<Border d:Visibility="Collapsed" Visibility="{Binding CurrentHasPost, Converter={StaticResource Boolean2VisibilityConverter}}">
						<local:PostDetailView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}"/>
						<!--<ContentControl Content="{Binding PostDetailViewModel.View}"/>-->
					</Border>

				</Grid>
			</Border>

		</DockPanel>

		<wpf:ButtonPopup SourceButton="{Binding ElementName=CurrentPageButton}">
			<Border Style="{StaticResource ButtonPopupBorder}">

			</Border>
		</wpf:ButtonPopup>

	</Grid>

</UserControl>
