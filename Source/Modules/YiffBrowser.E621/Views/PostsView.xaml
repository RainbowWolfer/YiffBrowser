<UserControl
	x:Class="YiffBrowser.E621.Views.PostsView"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c1="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:enums="clr-namespace:YiffBrowser.E621.Enums"
	xmlns:ex="clr-namespace:YiffBrowser.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="clr-namespace:YiffBrowser.E621.Models"
	xmlns:subs="clr-namespace:YiffBrowser.E621.Views.Subs"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:PostsViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>

		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>

		<wpf:CommandProxy x:Key="ViewPostDetailCommand" Command="{Binding ViewPostDetailCommand}"/>

		<wpf:CommandProxy x:Key="LocateLastViewedCommand" Command="{Binding LocateLastViewedCommand}"/>

		<wpf:CommandProxy x:Key="OpenPostCommand" Command="{Binding OpenPostCommand}"/>
		<wpf:CommandProxy x:Key="DownloadPostCommand" Command="{Binding DownloadPostCommand}"/>
		<wpf:CommandProxy x:Key="SelectPostCommand" Command="{Binding SelectPostCommand}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:DispatcherServiceEx/>

		<bf:AppSettingsDialogService/>

		<dxmvvm:KeyToCommand Command="{Binding DismissDownloadCommand}" KeyGesture="Esc"/>
	</dxmvvm:Interaction.Behaviors>

	<Grid>
		<DockPanel IsEnabled="{Binding DownloadMode, Converter={StaticResource EqualToBoolConverter}, ConverterParameter={x:Static enums:DownloadMode.None}}">

			<Border>
				<Grid>

					<Border Visibility="{Binding CurrentHasPost, Converter={StaticResource Boolean2VisibilityReConverter}}">
						<DockPanel>
							<Border Padding="4" Background="{DynamicResource RegionBrush}" DockPanel.Dock="Top">

								<Grid>
									<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Left">
										<Button
											Width="100"
											Command="{Binding OpenLastViewedPostCommand}"
											ToolTip="Last Viewed Post"
											Visibility="{Binding LastViewedPost, Converter={StaticResource Object2VisibilityConverter}}">
											<Button.Background>
												<ImageBrush ImageSource="{Binding LastViewedPost.Preview.URL, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
											</Button.Background>

											<Button.ContextMenu>
												<ContextMenu>
													<MenuItem Command="{StaticResource LocateLastViewedCommand}" Header="Locate"/>
												</ContextMenu>
											</Button.ContextMenu>
										</Button>
									</wpf:SpacingStackPanel>

									<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Center" IsEnabled="{Binding TabItem.LoadingStatus.ShowLoading, Converter={StaticResource Boolean2BooleanReConverter}}">

										<Button Name="ViewConfigButton"
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											ToolTip="View Config">
											<wpf:FontIcon Text="&#xE9E9;"/>
										</Button>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding RefreshCommand}"
											ToolTip="Refresh">
											<wpf:FontIcon Text="&#xE72C;"/>
										</Button>

										<Border Style="{StaticResource HorizontalSeparator}"/>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding PreviousPageCommand}"
											IsEnabled="{Binding CanGoLeft}"
											ToolTip="Previous Page">
											<wpf:FontIcon Text="&#xE76B;"/>
										</Button>

										<Button x:Name="CurrentPageButton"
											Style="{StaticResource Button.Custom.Icon}"
											Height="30"
											MinWidth="30"
											Padding="8,0"
											ToolTip="Current Page">
											<TextBlock d:Text="99" FontSize="16" Text="{Binding CurrentPage}"/>
										</Button>

										<Button
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding NextPageCommand}"
											ToolTip="Next Page">
											<wpf:FontIcon Text="&#xE76C;"/>
										</Button>

										<Border Style="{StaticResource HorizontalSeparator}"/>

										<wpf:MenuButton
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											Command="{Binding DownloadCommand}"
											ToolTip="Download">
											<wpf:FontIcon Text="&#xE896;"/>

											<wpf:MenuButton.ContextMenu>
												<ContextMenu>
													<MenuItem bf:IconExtension.Glyph="" Command="{Binding DownloadSelectedCommand}" Header="Download Selected"/>
													<MenuItem Command="{Binding DownloadCurrentPageCommand}" Header="Download Current Page"/>
													<Separator/>
													<MenuItem Command="{Binding CustomDownloadCommand}" Header="Custom Download"/>
												</ContextMenu>
											</wpf:MenuButton.ContextMenu>

										</wpf:MenuButton>

										<ToggleButton
											Style="{DynamicResource ToggleButton.Custom.Soild}"
											Height="30"
											MinWidth="30"
											Padding="8,0"
											IsChecked="{Binding IsMultiSelecting, Mode=TwoWay}"
											ToolTip="Toggle Selection">

											<DockPanel>
												<wpf:FontIcon Text="&#xE152;"/>
												<TextBlock
													d:Text="1/75"
													Margin="6,0,0,0"
													Text="{Binding MultiSelectingText}"
													Visibility="{Binding MultiSelectingText, Converter={StaticResource String2VisibilityConverter}}"/>
											</DockPanel>

											<!--<bf:HorizontalIconText
												d:Text="1/75"
												Glyph="&#xE152;"
												IconForeground="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Foreground}"
												Spacing="6"
												Text="{Binding MultiSelectingText}"/>-->

										</ToggleButton>


										<wpf:MenuButton
											Style="{StaticResource Button.Custom.Icon}"
											Width="30"
											Height="30"
											ToolTip="More Selection Options"
											Visibility="{Binding IsMultiSelecting, Converter={StaticResource Boolean2VisibilityConverter}}">
											<wpf:FontIcon Text="&#xE70D;"/>

											<wpf:MenuButton.ContextMenu>
												<ContextMenu>
													<MenuItem bf:IconExtension.Glyph="&#xE8B3;" Command="{Binding SelectAllCommand}" Header="Select All"/>
													<MenuItem bf:IconExtension.Glyph="&#xEF1F;" Command="{Binding ToggleSelectionCommand}" Header="Toggle Selection"/>
													<Separator/>
													<MenuItem bf:IconExtension.Glyph="&#xE8E6;" Command="{Binding ClearSelectionCommand}" Header="Clear Selection"/>
												</ContextMenu>
											</wpf:MenuButton.ContextMenu>

										</wpf:MenuButton>


									</wpf:SpacingStackPanel>

									<wpf:ButtonPopup SourceButton="{Binding ElementName=ViewConfigButton}" VerticalOffset="8">
										<Border Style="{DynamicResource ButtonPopupBorder}">
											<wpf:SpacingStackPanel Style="{DynamicResource CustomVerticalPanel2}">

												<wpf:TitleContent Title="Post Item Width">
													<c1:PostItemWidthOptionSelector PostItemWidthOptions="{Binding ViewConfigService.PostItemWidthOptions}" SelectedPostItemWidthOption="{Binding ViewConfigService.SelectedPostItemWidthOption}"/>
													<!--<hc:ButtonGroup Style="{DynamicResource ButtonGroupSolid}" Orientation="Vertical">
														<RadioButton Content="Extra Small"/>
														<RadioButton Content="Small"/>
														<RadioButton Content="Default"/>
														<RadioButton Content="Large"/>
														<RadioButton Content="Extra Large"/>
													</hc:ButtonGroup>-->
												</wpf:TitleContent>

											</wpf:SpacingStackPanel>
										</Border>
									</wpf:ButtonPopup>

								</Grid>

							</Border>

							<Border DockPanel.Dock="Top" Visibility="{Binding TabItem.LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
								<ProgressBar Style="{StaticResource ProgressBarFlat}" Height="10" IsIndeterminate="True"/>
							</Border>

							<c1:PostCardListBox x:Name="PostsListBox"
								Padding="2"
								BorderThickness="0,1,0,0"
								BorderBrush="{DynamicResource BorderBrush}"
								bf:SelectorExtension.SelectedItems="{Binding SelectedItems}"
								AllowSelection="{Binding IsMultiSelecting}"
								Background="{DynamicResource RegionBrush}"
								EnableKeyDown="False"
								RightButtonScroll="True"
								RightButtonScrollCursor="ScrollNS"
								RightButtonSelect="False"
								VirtualizingPanel.IsVirtualizing="False"
								VirtualizingPanel.ScrollUnit="Pixel"
								ItemsSource="{Binding Items}"
								d:ItemsSource="{d:SampleData ItemCount=15}">

								<dxmvvm:Interaction.Behaviors>
									<b:TypedUIObjectService Name="PostsListBoxService"/>
								</dxmvvm:Interaction.Behaviors>

								<ItemsControl.Style>
									<Style TargetType="{x:Type bf:VariableSizedWrapGridView}">
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="{x:Type bf:VariableSizedWrapGridView}">
													<Border
														BorderThickness="{TemplateBinding BorderThickness}"
														BorderBrush="{TemplateBinding BorderBrush}"
														Background="{TemplateBinding Background}"
														SnapsToDevicePixels="True">
														<hc:ScrollViewer Name="PART_ScrollViewer"
															Padding="{TemplateBinding Padding}"
															hc:ScrollViewerAttach.AutoHide="False"
															hc:ScrollViewerAttach.Orientation="Vertical"
															CanContentScroll="False"
															HorizontalScrollBarVisibility="Disabled"
															IsInertiaEnabled="True"
															VerticalScrollBarVisibility="Auto">
															<ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
														</hc:ScrollViewer>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsMultiSelecting}" Value="True">
												<Setter Property="SelectionMode" Value="Multiple"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding IsMultiSelecting}" Value="False">
												<Setter Property="SelectionMode" Value="Single"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ItemsControl.Style>

								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<bf:VariableSizedWrapGrid
											HorizontalChildrenAlignment="Stretch"
											ItemHeight="{Binding ViewConfigService.PostItemHeight}"
											ItemWidth="{Binding ViewConfigService.PostItemWidth}"
											Orientation="Horizontal"
											VerticalChildrenAlignment="Stretch"
											VerticalScrollAmount="200"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemContainerStyle>
									<Style TargetType="c1:PostCardListBoxItem" BasedOn="{StaticResource {x:Type c1:PostCardListBoxItem}}">
										<EventSetter Event="RequestBringIntoView" Handler="ListBoxItem_RequestBringIntoView"/>
										<Setter Property="bf:ListBoxItemClickExtension.AllowSelection" Value="{Binding Source={StaticResource ViewModel}, Path=Data.IsMultiSelecting}"/>
										<Setter Property="bf:ListBoxItemClickExtension.ClickCommand" Value="{StaticResource ViewPostDetailCommand}"/>
										<Setter Property="bf:ListBoxItemClickExtension.ClickCommandParameter" Value="{Binding Post}"/>
										<Setter Property="Margin" Value="0"/>
										<Setter Property="Padding" Value="2"/>
										<Setter Property="BorderThickness" Value="3"/>
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="VerticalContentAlignment" Value="Stretch"/>
										<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="c1:PostCardListBoxItem">
													<Border Margin="{TemplateBinding Padding}">
														<ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" UseLayoutRounding="{TemplateBinding UseLayoutRounding}"/>
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Setter Property="ContextMenu">
											<Setter.Value>
												<ContextMenu>
													<MenuItem
														bf:IconExtension.Glyph="&#xE89F;"
														Command="{StaticResource OpenPostCommand}"
														CommandParameter="{Binding PlacementTarget.DataContext.Post, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
														Header="Open"/>
													<MenuItem
														bf:IconExtension.Glyph="&#xE896;"
														Command="{StaticResource DownloadPostCommand}"
														CommandParameter="{Binding PlacementTarget.DataContext.Post, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
														Header="Quick Download"/>
													<MenuItem
														bf:IconExtension.Glyph="&#xE762;"
														Command="{StaticResource SelectPostCommand}"
														CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
														Header="Select"/>
												</ContextMenu>
											</Setter.Value>
										</Setter>
									</Style>
								</ItemsControl.ItemContainerStyle>

							</c1:PostCardListBox>

						</DockPanel>
					</Border>

					<Border d:Visibility="Collapsed" Visibility="{Binding CurrentHasPost, Converter={StaticResource Boolean2VisibilityConverter}}">
						<local:PostDetailView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}"/>
						<!--<ContentControl Content="{Binding PostDetailViewModel.View}"/>-->
					</Border>

				</Grid>
			</Border>

		</DockPanel>

		<!-- Backdrop fades; dialog panel (inner Border) scales + slides up. Visibility is storyboard-driven so exit can fade out. -->
		<Grid d:Visibility="Visible">
			<Grid.Style>
				<Style TargetType="Grid">
					<Setter Property="Visibility" Value="Collapsed"/>
					<Setter Property="Opacity" Value="0"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding DownloadMode, Converter={StaticResource EqualToBoolConverter}, ConverterParameter={x:Static enums:DownloadMode.None}}" Value="False">
							<DataTrigger.EnterActions>
								<StopStoryboard BeginStoryboardName="DownloadOverlayHide"/>
								<BeginStoryboard x:Name="DownloadOverlayShow" HandoffBehavior="SnapshotAndReplace">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											From="0"
											To="1"
											Duration="0:0:0.22">
											<DoubleAnimation.EasingFunction>
												<QuadraticEase EasingMode="EaseOut"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<StopStoryboard BeginStoryboardName="DownloadOverlayShow"/>
								<BeginStoryboard x:Name="DownloadOverlayHide" HandoffBehavior="SnapshotAndReplace">
									<Storyboard>
										<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28">
											<DoubleAnimation.EasingFunction>
												<QuadraticEase EasingMode="EaseIn"/>
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
											<DiscreteObjectKeyFrame KeyTime="0:0:0.28" Value="{x:Static Visibility.Collapsed}"/>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>

			<Grid.Background>
				<SolidColorBrush Opacity="0.4" Color="Black"/>
			</Grid.Background>

			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService x:Name="DownloadDialogRootService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border
				MinWidth="200"
				MinHeight="80"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				BorderThickness="1"
				BorderBrush="{DynamicResource BorderBrush}"
				Background="{DynamicResource SecondaryRegionBrush}"
				CornerRadius="8"
				RenderTransformOrigin="0.5,0.5">

				<Border.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="1" ScaleY="1"/>
						<TranslateTransform Y="0"/>
					</TransformGroup>
				</Border.RenderTransform>

				<Border.Style>
					<Style TargetType="Border">
						<Style.Triggers>
							<DataTrigger Binding="{Binding DownloadMode, Converter={StaticResource EqualToBoolConverter}, ConverterParameter={x:Static enums:DownloadMode.None}}" Value="False">
								<DataTrigger.EnterActions>
									<StopStoryboard BeginStoryboardName="DownloadPanelHide"/>
									<BeginStoryboard x:Name="DownloadPanelShow" HandoffBehavior="SnapshotAndReplace">
										<Storyboard>
											<DoubleAnimation
												Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
												From="0.94"
												To="1"
												Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
												From="0.94"
												To="1"
												Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation
												Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
												From="28"
												To="0"
												Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</DataTrigger.EnterActions>
								<DataTrigger.ExitActions>
									<StopStoryboard BeginStoryboardName="DownloadPanelShow"/>
									<BeginStoryboard x:Name="DownloadPanelHide" HandoffBehavior="SnapshotAndReplace">
										<Storyboard>
											<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseIn"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseIn"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
											<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="16" Duration="0:0:0.28">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseIn"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</DataTrigger.ExitActions>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>

				<Border.Effect>
					<DropShadowEffect
						BlurRadius="20"
						Opacity="0.3"
						ShadowDepth="0"
						Color="{DynamicResource PrimaryTextColor}"/>
				</Border.Effect>

				<Grid>

					<Grid IsEnabled="{Binding DownloadConfig.LoadingStatus_GetPosts.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
						<Grid.RowDefinitions>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="auto"/>
						</Grid.RowDefinitions>

						<Border Grid.Row="0">
							<DockPanel Margin="4,4,4,0">
								<Border Margin="6,0">
									<TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding DownloadMode, Converter={StaticResource EnumDisplayConverter}}"/>
								</Border>
								<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel2}" HorizontalAlignment="Right">
									<Button
										Width="24"
										Height="24"
										Padding="0"
										BorderThickness="0"
										Command="{Binding OpenSettingsCommand}">
										<wpf:FontIcon Text="&#xE713;"/>
									</Button>
									<Button
										Width="24"
										Height="24"
										Padding="0"
										BorderThickness="0"
										Command="{Binding DismissDownloadCommand}">
										<wpf:FontIcon Text="&#xE711;"/>
									</Button>
								</wpf:SpacingStackPanel>
							</DockPanel>
						</Border>

						<Grid Grid.Row="1" Margin="6">

							<Border d:Visibility="Collapsed" Width="400" Visibility="{Binding DownloadMode, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter={x:Static enums:DownloadMode.DownloadSelected}}">
								<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel3}">

									<Border Padding="4,2" Background="{DynamicResource ThirdlyRegionBrush}" CornerRadius="4">
										<TextBlock Text="{Binding SelectedItems.Count, StringFormat='{}Selected {0} Posts'}" TextAlignment="Center"/>
									</Border>

								</wpf:SpacingStackPanel>
							</Border>

							<Border d:Visibility="Collapsed" Width="400" Visibility="{Binding DownloadMode, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter={x:Static enums:DownloadMode.DownloadCurrentPage}}">
								<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel3}">

									<Border Padding="4,2" Background="{DynamicResource ThirdlyRegionBrush}" CornerRadius="4">
										<TextBlock Text="{Binding Items.Count, StringFormat='{}{0} Posts'}" TextAlignment="Center"/>
									</Border>

								</wpf:SpacingStackPanel>
							</Border>

							<!--
								Only materialize CustomDownload UI when that mode is active,
								so MaxPage/FromPage bindings are not evaluated against other DownloadConfig types.
							-->
							<ContentControl>
								<ContentControl.Style>
									<Style TargetType="ContentControl">
										<Setter Property="Content" Value="{x:Null}"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding DownloadMode}" Value="{x:Static enums:DownloadMode.CustomDownload}">
												<Setter Property="Content" Value="{Binding DownloadConfig}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ContentControl.Style>
								<ContentControl.Resources>
									<DataTemplate DataType="{x:Type local:CustomDownloadViewModel}">
										<Border Width="420">
											<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel3}">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>

													<TextBlock Margin="6,0" VerticalAlignment="Bottom" Text="Page Range"/>

													<wpf:SpacingStackPanel
														Style="{DynamicResource CustomHorizontalPanel2}"
														Grid.Column="1"
														Margin="6,0"
														HorizontalAlignment="Right">

														<TextBlock VerticalAlignment="Center" Text="From"/>
														<hc:NumericUpDown
															Style="{DynamicResource NumericUpDownPlus.Small}"
															MinWidth="40"
															Padding="4,0"
															Minimum="1"
															Maximum="{Binding MaxPage}"
															Value="{Binding FromPage, UpdateSourceTrigger=PropertyChanged}"/>

														<Border Width="1"/>

														<TextBlock VerticalAlignment="Center" Text="To"/>
														<hc:NumericUpDown
															Style="{DynamicResource NumericUpDownPlus.Small}"
															MinWidth="40"
															Padding="4,0"
															Minimum="1"
															Maximum="{Binding MaxPage}"
															Value="{Binding ToPage, UpdateSourceTrigger=PropertyChanged}"/>

														<Border Width="1"/>

														<TextBlock VerticalAlignment="Center" Text="Max"/>
														<TextBlock VerticalAlignment="Center" Text="{Binding MaxPage}"/>
													</wpf:SpacingStackPanel>
												</Grid>

												<hc:RangeSlider
													Minimum="1"
													Maximum="{Binding MaxPage}"
													Background="{DynamicResource BorderBrush}"
													Interval="1"
													IsSnapToTickEnabled="False"
													TickFrequency="{DXBinding 'MaxPage / 30'}"
													TickPlacement="BottomRight"
													ValueEnd="{Binding ToPage, UpdateSourceTrigger=PropertyChanged}"
													ValueStart="{Binding FromPage, UpdateSourceTrigger=PropertyChanged}"/>

												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="4"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="4"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>
													<Button
														Grid.Column="0"
														HorizontalAlignment="Stretch"
														Command="{Binding RefreshMaxPageCommand}"
														Content="Refresh Max Page"/>
													<Button
														Grid.Column="2"
														HorizontalAlignment="Stretch"
														Command="{Binding SelectCurrentPageCommand}"
														Content="Select Current Page"/>
													<Button
														Grid.Column="4"
														HorizontalAlignment="Stretch"
														Command="{Binding SelectAllPageCommand}"
														Content="Select All Pages"/>
												</Grid>

												<Grid Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
													<ProgressBar Height="18" Background="{DynamicResource BorderBrush}" IsIndeterminate="True"/>
													<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Refreshing Max Page"/>
												</Grid>
											</wpf:SpacingStackPanel>
										</Border>
									</DataTemplate>
								</ContentControl.Resources>
							</ContentControl>

						</Grid>

						<Border Grid.Row="2">
							<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel3}" Margin="6">
								<Separator/>
								<CheckBox Margin="4,0" Content="Custom Destination Path" IsChecked="{Binding DownloadConfig.UseCustomPath}"/>
								<bf:FolderSelectionControl Path="{Binding DownloadConfig.CustomPath}" Visibility="{Binding DownloadConfig.UseCustomPath, Converter={StaticResource Boolean2VisibilityConverter}}"/>

								<Border>
									<StackPanel Opacity="0.7">
										<TextBlock Text="Will be downloaded to:"/>
										<TextBlock Text="{Binding DownloadConfig.DestinationFolder}" TextWrapping="Wrap"/>
									</StackPanel>
								</Border>

								<Border>
									<Button
										Style="{DynamicResource ButtonPrimary}"
										Margin="0"
										HorizontalAlignment="Right"
										Command="{Binding DownloadConfig.ConfirmCommand}"
										Content="Confirm"/>
								</Border>
							</wpf:SpacingStackPanel>
						</Border>

					</Grid>

					<Grid Visibility="{Binding DownloadConfig.LoadingStatus_GetPosts.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
						<Border
							Padding="8"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{DynamicResource RegionBrush}"
							CornerRadius="8">

							<Border.Effect>
								<DropShadowEffect
									BlurRadius="20"
									Opacity="0.3"
									ShadowDepth="0"
									Color="{DynamicResource PrimaryTextColor}"/>
							</Border.Effect>

							<StackPanel MinWidth="160">
								<hc:CircleProgressBar
									Width="40"
									Height="40"
									Margin="4"
									wpf:ProgressBarExtension.Progress="{Binding DownloadConfig.LoadingStatus_GetPosts.Progress}"
									IsIndeterminate="True"/>
								<TextBlock
									d:Text="Loading Posts"
									Margin="4"
									Text="{Binding DownloadConfig.LoadingStatus_GetPosts.DownloadInfo}"
									TextAlignment="Center"/>
								<Button
									Style="{StaticResource ButtonDefault.Small}"
									Margin="4"
									Command="{Binding DownloadConfig.CancelLoadingCommand}"
									Content="Cancel"/>
							</StackPanel>
						</Border>
					</Grid>

				</Grid>

			</Border>

		</Grid>

		<wpf:ButtonPopup
			OnClickOpenCommand="{Binding PaginationButtonPopupLoadedCommand}"
			Placement="Bottom"
			SourceButton="{Binding ElementName=CurrentPageButton}"
			VerticalOffset="8">
			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService Name="PaginationButtonPopupService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border Style="{StaticResource ButtonPopupBorder}">

				<wpf:SpacingStackPanel Style="{DynamicResource CustomVerticalPanel2}">

					<ProgressBar Height="8" IsIndeterminate="True" Visibility="{Binding IsLoadingPagination, Converter={StaticResource Boolean2VisibilityConverter}}"/>

					<wpf:SpacingStackPanel Style="{DynamicResource CustomHorizontalPanel2}">

						<bf:PaginationEx x:Name="Pagination"
							IsEnabled="{Binding IsLoadingPagination, Converter={StaticResource Boolean2BooleanReConverter}}"
							IsJumpEnabled="False"
							MaxPageCount="{Binding MaxPage}"
							PageIndex="{Binding CurrentPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
							<dxmvvm:Interaction.Behaviors>
								<dxmvvm:EventToCommand Command="{Binding PageUpdatedCommand}" EventName="PageUpdated" PassEventArgsToCommand="True"/>
							</dxmvvm:Interaction.Behaviors>
						</bf:PaginationEx>

						<!-- {Binding ElementName=Pagination, Path=MaxPageCount} -->
						<!-- don't bind the MaxPageCount, in case of calculating error -->
						<hc:NumericUpDown
							MinWidth="60"
							Minimum="1"
							Maximum="750"
							Value="{Binding PaginationInputPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

						<Button Command="{Binding JumpCommand}" Content="Jump"/>

					</wpf:SpacingStackPanel>

				</wpf:SpacingStackPanel>

			</Border>
		</wpf:ButtonPopup>

	</Grid>

</UserControl>
