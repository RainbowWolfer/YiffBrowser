<UserControl
	x:Class="YiffBrowser.E621.Views.PostDetailDockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:c="clr-namespace:YiffBrowser.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DesignHeight="450"
	d:DesignWidth="500"
	mc:Ignorable="d">

	<Control.Resources>

		<!--<wpf:CommandProxy x:Key="CloseTabCommand" Command="{Binding CloseTabCommand}"/>-->

	</Control.Resources>

	<Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:PostDetailDockView}}">
		<TabControl Padding="0" BorderThickness="0,1,0,0">
			<TabItem Header="Description">
				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<ScrollViewer Padding="4">
						<Border>
							<TextBox
								d:Text="No Description"
								Style="{StaticResource SelectableTextBlock}"
								Padding="4,0"
								VerticalAlignment="Stretch"
								FontSize="18"
								Text="{Binding Description, Mode=OneWay}"
								TextWrapping="Wrap"/>
						</Border>
					</ScrollViewer>

					<Border Grid.Row="1" Padding="4">
						<StackPanel>
							<TextBlock
								d:Text="No Source"
								Margin="4,0"
								FontSize="20"
								Text="{Binding SourceTitle}"/>
							<ListBox
								MaxHeight="200"
								Padding="0"
								BorderThickness="0"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ItemsSource="{Binding SourceURLs}">
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle.Small}">
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="VerticalContentAlignment" Value="Center"/>
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<!--<c:SourceHyperLinkButton URL="{Binding}" Height="30"/>-->
										<Border/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>

			<TabItem>
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Comments"/>
						<TextBlock Margin="4,0,0,0" Text="{Binding Post.CommentCount}" Visibility="{Binding Post.CommentCount, Converter={StaticResource IListToVisibilityConverter}}"/>
					</StackPanel>
				</TabItem.Header>

				<Border>
					<Grid>
						<Border Visibility="{Binding Post.CommentCount, Converter={StaticResource IListToVisibilityReConverter}}">
							<TextBlock Margin="8,4" FontSize="18" Text="No Comments"/>
						</Border>

						<Border Margin="10" VerticalAlignment="Top" Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
							<ProgressBar Height="8" IsIndeterminate="True"/>
						</Border>

						<Border Visibility="{Binding Post.CommentCount, Converter={StaticResource IListToVisibilityConverter}}">
							<hc:ScrollViewer Margin="4" hc:ScrollViewerAttach.AutoHide="False" IsInertiaEnabled="True">
								<ItemsControl ItemsSource="{Binding Comments}" d:ItemsSource="{d:SampleData ItemCount=15}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="4">
												<c:CommentControl Comment="{Binding}"/>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</hc:ScrollViewer>
						</Border>

						<Border Padding="8,4" Visibility="{Binding LoadingStatus.ErrorMessage, Converter={StaticResource String2VisibilityConverter}}">
							<StackPanel>
								<bf:HorizontalIconText
									Margin="4"
									FontSize="24"
									Foreground="{DynamicResource DangerBrush}"
									Glyph="&#xE7BA;"
									IconForeground="{DynamicResource DangerBrush}"
									IconSize="28"
									Text="Error Loading"/>
								<TextBlock
									Margin="4,0"
									FontSize="14"
									Text="{Binding LoadingStatus.ErrorMessage}"
									TextWrapping="Wrap"/>
							</StackPanel>
						</Border>

					</Grid>
				</Border>

			</TabItem>

			<TabItem Header="Relations">
				<ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<Border Margin="0,0,0,8" Visibility="{Binding RelationsLoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
							<ProgressBar Height="6" IsIndeterminate="True"/>
						</Border>

						<Button
							Margin="0,0,0,12"
							HorizontalAlignment="Left"
							Click="OpenRelationsGraph_Click"
							Content="Open relationship graph"/>

						<TextBlock
							Margin="0,0,0,8"
							FontSize="16"
							Opacity="0.7"
							Text="No parent / children"
							Visibility="{Binding HasRelations, Converter={StaticResource Boolean2VisibilityReConverter}}"/>

						<TextBlock
							Margin="0,0,0,4"
							FontWeight="SemiBold"
							Text="Parent"
							Visibility="{Binding ParentItems.Count, Converter={StaticResource IListToVisibilityConverter}}"/>
						<ItemsControl Margin="0,0,0,12" ItemsSource="{Binding ParentItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										Width="120"
										Margin="0,0,8,8"
										Padding="4"
										Background="{DynamicResource RegionBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="4"
										Cursor="Hand"
										MouseLeftButtonUp="RelationNeighbor_Click">
										<StackPanel>
											<Border Height="90" ClipToBounds="True" CornerRadius="3">
												<Border.Background>
													<ImageBrush ImageSource="{Binding PreviewUrl}" Stretch="UniformToFill"/>
												</Border.Background>
											</Border>
											<TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Text="{Binding Title}"/>
											<TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.7" Text="{Binding Role}"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>

						<TextBlock
							Margin="0,0,0,4"
							FontWeight="SemiBold"
							Text="Children"
							Visibility="{Binding ChildItems.Count, Converter={StaticResource IListToVisibilityConverter}}"/>
						<ItemsControl Margin="0,0,0,12" ItemsSource="{Binding ChildItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										Width="120"
										Margin="0,0,8,8"
										Padding="4"
										Background="{DynamicResource RegionBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="4"
										Cursor="Hand"
										MouseLeftButtonUp="RelationNeighbor_Click">
										<StackPanel>
											<Border Height="90" ClipToBounds="True" CornerRadius="3">
												<Border.Background>
													<ImageBrush ImageSource="{Binding PreviewUrl}" Stretch="UniformToFill"/>
												</Border.Background>
											</Border>
											<TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Text="{Binding Title}"/>
											<TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.7" Text="{Binding Role}"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>

						<TextBlock
							Margin="0,8,0,4"
							FontWeight="SemiBold"
							Text="Pools"
							Visibility="{Binding HasPools, Converter={StaticResource Boolean2VisibilityConverter}}"/>
						<ItemsControl ItemsSource="{Binding PoolItems}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button
										Margin="0,0,8,8"
										Padding="10,4"
										Click="PoolChip_Click"
										Content="{Binding Label}"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

		</TabControl>
	</Grid>

</UserControl>
