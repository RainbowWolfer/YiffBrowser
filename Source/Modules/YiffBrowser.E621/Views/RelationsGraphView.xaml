<UserControl
	x:Class="YiffBrowser.E621.Views.RelationsGraphView"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>
		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>
	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:DispatcherServiceEx/>
	</dxmvvm:Interaction.Behaviors>

	<Grid>
		<DockPanel Visibility="{Binding PostsHost.CurrentHasPost, Converter={StaticResource Boolean2VisibilityReConverter}}">
			<Border
				Padding="8,6"
				Background="{DynamicResource RegionBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="0,0,0,1"
				DockPanel.Dock="Top">
				<Grid>
					<StackPanel VerticalAlignment="Center">
						<TextBlock FontWeight="SemiBold" Text="{Binding TabItem.Title}"/>
						<TextBlock Margin="0,2,0,0" Opacity="0.75" Text="{Binding StatusText}"/>
					</StackPanel>
					<Button
						Width="30"
						Height="30"
						HorizontalAlignment="Right"
						Command="{Binding RefreshCommand}"
						Style="{StaticResource Button.Custom.Icon}"
						ToolTip="Refresh">
						<wpf:FontIcon Text="&#xE72C;"/>
					</Button>
				</Grid>
			</Border>

			<Border DockPanel.Dock="Top" Visibility="{Binding TabItem.LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
				<ProgressBar Height="4" IsIndeterminate="True"/>
			</Border>

			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<Canvas>
					<dxmvvm:Interaction.Behaviors>
						<b:TypedUIObjectService Name="GraphCanvasService"/>
					</dxmvvm:Interaction.Behaviors>
				</Canvas>
			</ScrollViewer>
		</DockPanel>

		<Border Visibility="{Binding PostsHost.CurrentHasPost, Converter={StaticResource Boolean2VisibilityConverter}}">
			<local:PostDetailView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding PostsHost}"/>
		</Border>
	</Grid>
</UserControl>
