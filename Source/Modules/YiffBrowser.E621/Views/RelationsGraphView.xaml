<UserControl
	x:Class="YiffBrowser.E621.Views.RelationsGraphView"
	x:ClassModifier="internal"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="YiffBrowser.BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:local="clr-namespace:YiffBrowser.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:RelationsGraphViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>
		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>
	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:DispatcherServiceEx/>
	</dxmvvm:Interaction.Behaviors>

	<Grid Background="{DynamicResource SecondaryRegionBrush}">

		<DockPanel Visibility="{Binding GraphVisibility}">

			<Border
				Padding="8,6"
				Background="{DynamicResource RegionBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="0,0,0,1"
				DockPanel.Dock="Top">
				<Grid>
					<StackPanel VerticalAlignment="Center">
						<TextBlock FontWeight="SemiBold" Text="{Binding HeaderTitle}"/>
						<TextBlock
							Margin="0,2,0,0"
							FontSize="11"
							Opacity="0.75"
							Text="{Binding StatusText}"/>
					</StackPanel>
					<StackPanel
						HorizontalAlignment="Right"
						Orientation="Horizontal">
						<TextBlock
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							FontFamily="Cascadia Mono"
							FontSize="11"
							Opacity="0.65"
							Text="{Binding ElementName=WorldScale, Path=ScaleX, StringFormat={}{0:P0}}"/>
						<Button
							Width="30"
							Height="30"
							Click="FitView_Click"
							Style="{StaticResource Button.Custom.Icon}"
							ToolTip="Fit to view (Home)">
							<wpf:FontIcon Text="&#xE740;"/>
						</Button>
						<Button
							Width="30"
							Height="30"
							Click="ResetZoom_Click"
							Style="{StaticResource Button.Custom.Icon}"
							ToolTip="Reset zoom to 100% (Ctrl+0)">
							<wpf:FontIcon Text="&#xE71E;"/>
						</Button>
						<Button
							Width="30"
							Height="30"
							Command="{Binding RefreshCommand}"
							Style="{StaticResource Button.Custom.Icon}"
							ToolTip="Refresh">
							<wpf:FontIcon Text="&#xE72C;"/>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<ProgressBar
				Height="4"
				DockPanel.Dock="Top"
				IsIndeterminate="True"
				Visibility="{Binding LoadingVisibility}"/>

			<Grid>
				<!-- Blender-like viewport: wheel zoom toward cursor, middle-drag pan. -->
				<Border
					x:Name="Viewport"
					Background="Transparent"
					ClipToBounds="True"
					Cursor="Arrow"
					Focusable="True"
					FocusVisualStyle="{x:Null}"
					PreviewMouseDown="Viewport_PreviewMouseDown"
					PreviewMouseMove="Viewport_PreviewMouseMove"
					PreviewMouseUp="Viewport_PreviewMouseUp"
					MouseLeave="Viewport_MouseLeave"
					MouseWheel="Viewport_MouseWheel"
					SizeChanged="Viewport_SizeChanged">

					<!-- World space: grid + graph share one transform (WPF transforms are single-parent). -->
					<Grid
						x:Name="World"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						RenderTransformOrigin="0,0">
						<Grid.RenderTransform>
							<TransformGroup>
								<ScaleTransform x:Name="WorldScale" ScaleX="1" ScaleY="1"/>
								<TranslateTransform x:Name="WorldTranslate"/>
							</TransformGroup>
						</Grid.RenderTransform>

						<Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>

						<Grid
							x:Name="GraphHost"
							Width="{Binding GraphWidth}"
							Height="{Binding GraphHeight}"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							Background="Transparent">

							<ItemsControl ItemsSource="{Binding Edges}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Path
											Data="{Binding Data}"
											Opacity="0.4"
											Stroke="{DynamicResource PrimaryTextBrush}"
											StrokeThickness="1.5"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding Nodes}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemContainerStyle>
									<Style TargetType="ContentPresenter">
										<Setter Property="Canvas.Left" Value="{Binding X}"/>
										<Setter Property="Canvas.Top" Value="{Binding Y}"/>
									</Style>
								</ItemsControl.ItemContainerStyle>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border
											Width="132"
											Height="156"
											Padding="5"
											Cursor="Hand"
											CornerRadius="6"
											MouseLeftButtonDown="NodeCard_MouseLeftButtonDown"
											MouseLeftButtonUp="NodeCard_MouseLeftButtonUp"
											ToolTip="{Binding ToolTipText}">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
													<Setter Property="BorderThickness" Value="{Binding BorderThickness}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsSeed}" Value="True">
															<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
														</DataTrigger>
														<Trigger Property="IsMouseOver" Value="True">
															<Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
															<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
														</Trigger>
													</Style.Triggers>
												</Style>
											</Border.Style>

											<DockPanel>
												<TextBlock
													DockPanel.Dock="Bottom"
													FontSize="10"
													HorizontalAlignment="Center"
													Opacity="0.7"
													Text="{Binding Badge}"/>
												<TextBlock
													DockPanel.Dock="Bottom"
													FontFamily="Cascadia Mono"
													FontWeight="SemiBold"
													HorizontalAlignment="Center"
													Text="{Binding Title}"/>
												<wpf:ClippingBorder
													Background="{DynamicResource SecondaryRegionBrush}"
													CornerRadius="4">
													<Border Visibility="{Binding Source={x:Static bf:AppConfig.SafeMode}, Converter={StaticResource Boolean2VisibilityReConverter}}">
														<Image Source="{Binding PreviewImage, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
													</Border>
												</wpf:ClippingBorder>
											</DockPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Grid>
				</Border>

				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsHitTestVisible="False"
					Opacity="0.6"
					Text="{Binding StatusText}"
					Visibility="{Binding EmptyVisibility}"/>

				<TextBlock
					Margin="10"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					FontSize="11"
					IsHitTestVisible="False"
					Opacity="0.45"
					Text="Scroll: zoom · Middle-drag: pan · Home: fit"/>
			</Grid>
		</DockPanel>

		<Border Visibility="{Binding DetailVisibility}">
			<!-- PostDetailView overrides its own DataContext (DISource), so the parent view
			model has to be reached through the proxy instead of a plain {Binding}. -->
			<local:PostDetailView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data.PostsHost}"/>
		</Border>
	</Grid>
</UserControl>
