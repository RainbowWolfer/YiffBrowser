		<ProjectReference Include="..\YiffBrowser.BaseFramework\YiffBrowser.BaseFramework.csproj" />
		<ProjectReference Include="..\YiffBrowser.Redist\YiffBrowser.Redist.csproj" />
	</ItemGroup>

