<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:BaseFramework.Controls"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:wpf="RW.Common.WPF">

	<ControlTemplate x:Key="SliderThumb.Playback" TargetType="Thumb">
		<Canvas Width="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualWidth}">
			<Border x:Name="AnywhereCover"
				Width="10000"
				Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}"
				Margin="-5000,0,0,0"
				Background="Transparent"/>
			<Border Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}" VerticalAlignment="Stretch" Background="Transparent">
				<Border Name="BorderDot"
					Width="24"
					Height="18"
					VerticalAlignment="Center"
					BorderThickness="0"
					BorderBrush="{DynamicResource PrimaryBrush}"
					Background="White"
					CornerRadius="4"
					Effect="{StaticResource EffectShadow1}"/>
			</Border>
		</Canvas>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Effect" Value="{StaticResource EffectShadow2}"/>
			</Trigger>
			<EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
				<EventTrigger.Actions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimation
								Storyboard.TargetName="BorderDot"
								Storyboard.TargetProperty="BorderThickness"
								To="2"
								Duration="0:0:.1"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger.Actions>
			</EventTrigger>
			<EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
				<EventTrigger.Actions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimation
								Storyboard.TargetName="BorderDot"
								Storyboard.TargetProperty="BorderThickness"
								To="0"
								Duration="0:0:.1"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger.Actions>
			</EventTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="SliderRepeatButtonHorizontal.Playback" TargetType="RepeatButton">
		<Setter Property="OverridesDefaultStyle" Value="true"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Focusable" Value="false"/>
		<Setter Property="IsTabStop" Value="false"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent">
						<Rectangle
							Height="12"
							Fill="{TemplateBinding Background}"
							RadiusX="4"
							RadiusY="4"
							StrokeThickness="0"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="SliderHorizontal.Playback" TargetType="Slider">
		<Grid Background="{TemplateBinding Background}">
			<Border x:Name="TrackBackground"
				Height="6"
				Margin="9,0"
				VerticalAlignment="center"
				Background="{DynamicResource BorderBrush}"
				CornerRadius="4"/>
			<Track x:Name="PART_Track" Margin="9,0" ClipToBounds="False">
				<Track.DecreaseRepeatButton>
					<RepeatButton Style="{StaticResource SliderRepeatButtonHorizontal.Playback}" Background="{DynamicResource PrimaryBrush}" Command="{x:Static Slider.DecreaseLarge}"/>
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Style="{StaticResource SliderRepeatButtonHorizontal.Playback}" Command="{x:Static Slider.IncreaseLarge}"/>
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb x:Name="Thumb"
						Width="18"
						Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}"
						Margin="-12,0,-6,0"
						VerticalAlignment="Center"
						ClipToBounds="False"
						Focusable="False"
						OverridesDefaultStyle="True"
						Template="{StaticResource SliderThumb.Playback}"/>
				</Track.Thumb>
			</Track>
		</Grid>
	</ControlTemplate>


	<Style x:Key="Slider.Playback" TargetType="Slider" BasedOn="{StaticResource BaseStyle}">
		<Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}"/>
		<Setter Property="Template" Value="{StaticResource SliderHorizontal.Playback}"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Style.Triggers>
			<!--<Trigger Property="Orientation" Value="Vertical">
				<Setter Property="Template" Value="{StaticResource SliderVertical}"/>
			</Trigger>-->
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value=".4"/>
			</Trigger>
		</Style.Triggers>
	</Style>



	<Style x:Key="PlaybackControl" TargetType="c:PlaybackControl">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="c:PlaybackControl">
					<Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
						<Grid DataContext="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Orientation="Horizontal">
								<Button
									Width="30"
									Height="30"
									Padding="0"
									BorderThickness="0"
									hc:BorderElement.CornerRadius="0"
									Command="{Binding Player.Commands.TogglePlayPause}">
									<c:BoolContent Bool="{Binding Player.IsPlaying}">

										<c:BoolContent.TrueContent>
											<wpf:FontIcon Text="&#xE768;"/>
										</c:BoolContent.TrueContent>

										<c:BoolContent.FalseContent>
											<wpf:FontIcon Text="&#xE769;"/>
										</c:BoolContent.FalseContent>

									</c:BoolContent>
								</Button>
							</StackPanel>

							<Border Grid.Column="1" Background="Transparent" ClipToBounds="True">
								<c:SliderEx x:Name="PositionSlider"
									Style="{StaticResource Slider.Playback}"
									Margin="8,0"
									VerticalAlignment="Stretch"
									Maximum="{Binding Player.Duration}"
									Background="#01FFFFFF"
									IsMoveToPointEnabled="True"
									LargeChange="{Binding Player.Config.Player.SeekOffset2}"
									SmallChange="{Binding Player.Config.Player.SeekOffset}"
									Value="{Binding Player.CurTime}"/>
							</Border>

						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="c:PlaybackControl" BasedOn="{StaticResource PlaybackControl}"/>

</ResourceDictionary>