<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:wpf="RW.Common.WPF">

	<ControlTemplate x:Key="SliderThumb.Playback" TargetType="Thumb">
		<Canvas>
			<Border x:Name="AnywhereCover"
				Width="10000"
				Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}"
				Margin="-5000,0,0,0"
				Background="Transparent"/>
			<Border Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}" VerticalAlignment="Stretch" Background="Transparent">
				<Border Name="BorderDot"
					Width="24"
					Height="18"
					VerticalAlignment="Center"
					BorderThickness="0"
					BorderBrush="{DynamicResource PrimaryBrush}"
					Background="White"
					CornerRadius="4"
					Effect="{StaticResource EffectShadow1}"/>
			</Border>
		</Canvas>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Effect" Value="{StaticResource EffectShadow2}"/>
			</Trigger>
			<EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
				<EventTrigger.Actions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimation
								Storyboard.TargetName="BorderDot"
								Storyboard.TargetProperty="BorderThickness"
								To="2"
								Duration="0:0:.1"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger.Actions>
			</EventTrigger>
			<EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
				<EventTrigger.Actions>
					<BeginStoryboard>
						<Storyboard>
							<ThicknessAnimation
								Storyboard.TargetName="BorderDot"
								Storyboard.TargetProperty="BorderThickness"
								To="0"
								Duration="0:0:.1"/>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger.Actions>
			</EventTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="SliderRepeatButtonHorizontal.Playback" TargetType="RepeatButton">
		<Setter Property="OverridesDefaultStyle" Value="true"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Focusable" Value="false"/>
		<Setter Property="IsTabStop" Value="false"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent">
						<Rectangle
							Height="12"
							Fill="{TemplateBinding Background}"
							RadiusX="4"
							RadiusY="4"
							StrokeThickness="0"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ControlTemplate x:Key="SliderHorizontal.Playback" TargetType="Slider">
		<Grid Background="{TemplateBinding Background}">
			<Border x:Name="TrackBackground"
				Height="6"
				Margin="9,0"
				VerticalAlignment="center"
				Background="{DynamicResource BorderBrush}"
				CornerRadius="4"/>
			<Track x:Name="PART_Track" Margin="9,0">
				<Track.DecreaseRepeatButton>
					<RepeatButton Style="{StaticResource SliderRepeatButtonHorizontal.Playback}" Background="{DynamicResource PrimaryBrush}" Command="{x:Static Slider.DecreaseLarge}"/>
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Style="{StaticResource SliderRepeatButtonHorizontal.Playback}" Command="{x:Static Slider.IncreaseLarge}"/>
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb x:Name="Thumb"
						Width="18"
						Height="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=ActualHeight}"
						Margin="-12,0,-6,0"
						VerticalAlignment="Center"
						ClipToBounds="False"
						Focusable="False"
						OverridesDefaultStyle="True"
						Template="{StaticResource SliderThumb.Playback}"/>
				</Track.Thumb>
			</Track>
		</Grid>
	</ControlTemplate>


	<Style x:Key="Slider.Playback" TargetType="Slider" BasedOn="{StaticResource BaseStyle}">
		<Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource DarkPrimaryBrush}"/>
		<Setter Property="Template" Value="{StaticResource SliderHorizontal.Playback}"/>
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Style.Triggers>
			<!--<Trigger Property="Orientation" Value="Vertical">
				<Setter Property="Template" Value="{StaticResource SliderVertical}"/>
			</Trigger>-->
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value=".4"/>
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>