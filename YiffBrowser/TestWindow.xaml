<bf:WindowBase
	x:Class="YiffBrowser.TestWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YiffBrowser"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="TestWindow"
	Style="{StaticResource WindowBaseStyle}"
	Width="800"
	Height="450"
	mc:Ignorable="d">

	<Grid>
		<bf:WindowContent>
			<StackPanel>
				<bf:SliderEx
					Style="{StaticResource Slider.Playback}"
					Height="400"
					IsMoveToPointEnabled="True"
					ValueChanged="SliderEx_ValueChanged"/>
			</StackPanel>
		</bf:WindowContent>
	</Grid>

</bf:WindowBase>
