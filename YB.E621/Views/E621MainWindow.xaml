<bf:WindowBase
	x:Class="YB.E621.Views.E621MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:ex="clr-namespace:YB.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:hc_c="clr-namespace:HandyControl.Controls;assembly=HandyControl"
	xmlns:local="clr-namespace:YB.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:YB.E621.Parameters"
	xmlns:service="clr-namespace:YB.E621.Services"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:subs="clr-namespace:YB.E621.Views.Subs"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:E621MainWindowViewModel}"
	d:Title="E621 Window"
	DataContext="{b:DISource Type=local:E621MainWindowViewModel}"
	Width="1270"
	Height="800"
	Margin="0"
	Padding="0"
	hc:WindowAttach.ExtendContentToNonClientArea="False"
	hc:WindowAttach.IsDragElement="True"
	hc:WindowAttach.SystemBackdropType="Auto"
	ResizeMode="CanResizeWithGrip"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<!--<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="29"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="20"/>
	</shell:WindowChrome.WindowChrome>-->

	<Window.Style>

		<Style TargetType="bf:WindowBase" BasedOn="{StaticResource WindowBase}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding ViewParameter.ModuleType}" Value="{x:Static bf:ModuleType.E621}">
					<Setter Property="Icon" Value="/BaseFramework;component/Resources/Icons/E621Icon.ico"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding ViewParameter.ModuleType}" Value="{x:Static bf:ModuleType.E6AI}">
					<Setter Property="Icon" Value="/BaseFramework;component/Resources/Icons/E6AI.ico"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding ViewParameter.ModuleType}" Value="{x:Static bf:ModuleType.E926}">
					<Setter Property="Icon" Value="/BaseFramework;component/Resources/Icons/E621Icon.ico"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

	</Window.Style>

	<Grid>
		<Border x:Name="Root"/>
	</Grid>

</bf:WindowBase>
