<bf:WindowBase
	x:Class="YB.E621.Views.E621MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DataContext="{d:DesignInstance Type=local:E621MainWindowViewModel}"
	d:Title="E621 Window"
	Style="{StaticResource WindowBaseStyle}"
	DataContext="{b:DISource Type=local:E621MainWindowViewModel}"
	Width="1270"
	Height="800"
	ResizeMode="CanResizeWithGrip"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<bf:WindowContent>
		<Border x:Name="Root"/>
	</bf:WindowContent>

</bf:WindowBase>
