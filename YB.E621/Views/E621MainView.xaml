<UserControl
	x:Class="YB.E621.Views.E621MainView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:ex="clr-namespace:YB.E621.Extensions"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:hc_c="clr-namespace:HandyControl.Controls;assembly=HandyControl"
	xmlns:local="clr-namespace:YB.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:YB.E621.Parameters"
	xmlns:service="clr-namespace:YB.E621.Services"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:subs="clr-namespace:YB.E621.Views.Subs"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:E621MainViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Control.Resources>

		<Style x:Key="ButtonDynamicStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="TabItemStyle.Custom" TargetType="{x:Type TabItem}">
			<Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource TitleBrush}"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type TabItem}">
						<hc:SimplePanel Name="templateRoot" SnapsToDevicePixels="true">
							<Border Name="mainBorder"
								Margin="0"
								VerticalAlignment="Bottom"
								BorderThickness="0"
								BorderBrush="Transparent"
								Background="Transparent"
								CornerRadius="4,4,0,0">
								<ContentPresenter Name="contentPresenter"
									Margin="{TemplateBinding Padding}"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									ContentSource="Header"
									Focusable="False"
									RecognizesAccessKey="True"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
							</Border>
						</hc:SimplePanel>

						<ControlTemplate.Triggers>

							<Trigger Property="TabItem.IsSelected" Value="False">
								<Setter TargetName="mainBorder" Property="BorderThickness" Value="0,0,0,0"/>
								<Setter TargetName="mainBorder" Property="Background" Value="Transparent"/>
								<Setter TargetName="mainBorder" Property="Height" Value="24"/>
							</Trigger>

							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="mainBorder" Property="Background" Value="{DynamicResource ThirdlyRegionBrush}"/>
							</Trigger>

							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="contentPresenter" Property="UIElement.Opacity" Value="0.4"/>
							</Trigger>

							<Trigger Property="TabItem.IsSelected" Value="True">
								<Setter Property="Panel.ZIndex" Value="1"/>
								<Setter TargetName="mainBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
							</Trigger>

							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
									<Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Top"/>
								</MultiDataTrigger.Conditions>
								<Setter TargetName="mainBorder" Property="Height" Value="26"/>
							</MultiDataTrigger>

							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
									<Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Left"/>
								</MultiDataTrigger.Conditions>
							</MultiDataTrigger>

							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
									<Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Bottom"/>
								</MultiDataTrigger.Conditions>
							</MultiDataTrigger>

							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
									<Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Right"/>
								</MultiDataTrigger.Conditions>
							</MultiDataTrigger>

						</ControlTemplate.Triggers>

					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TabControlBaseStyle.Custom" TargetType="{x:Type TabControl}">
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
			<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="ItemContainerStyle" Value="{StaticResource TabItemStyle.Custom}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type TabControl}">
						<Grid Name="templateRoot"
							Background="Transparent"
							ClipToBounds="true"
							SnapsToDevicePixels="true">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Name="ColumnDefinition0"/>
								<ColumnDefinition Name="ColumnDefinition1" Width="0"/>
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition Name="RowDefinition0" Height="Auto"/>
								<RowDefinition Name="RowDefinition1" Height="*"/>
							</Grid.RowDefinitions>

							<Border Name="headerPanelBorder" Grid.Row="0" Margin="0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="auto"/>
									</Grid.ColumnDefinitions>

									<Grid.RowDefinitions>
										<RowDefinition Height="auto"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>

									<Grid
										Grid.Row="1"
										Grid.Column="0"
										Margin="8,4,8,0"
										Background="Transparent">
										<hc:ScrollViewer Name="tabHeaderScrollViewer"
											Background="Transparent"
											HorizontalScrollBarVisibility="Hidden"
											IsInertiaEnabled="True"
											VerticalScrollBarVisibility="Auto">
											<TabPanel Name="headerPanel" Background="Transparent" IsItemsHost="true"/>
										</hc:ScrollViewer>
									</Grid>

									<!--<Border Grid.Row="1" Grid.Column="1">
										<Button Style="{StaticResource Button.Custom.Icon}" Width="30" Height="30">
											<wpf:FontIcon Text="&#xE8C4;"/>
										</Button>
									</Border>-->
								</Grid>
							</Border>

							<Grid Name="contentPanel"
								Grid.Row="1"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch">

								<Border
									Height="1"
									VerticalAlignment="Top"
									Panel.ZIndex="99"
									Background="{DynamicResource PrimaryBrush}"/>

								<wpf:ClippingBorder BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
									<ContentPresenter Name="PART_SelectedContentHost"
										Margin="0,1,0,0"
										ContentSource="SelectedContent"
										SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
								</wpf:ClippingBorder>
							</Grid>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
								<Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
								<Setter TargetName="RowDefinition1" Property="Height" Value="Auto"/>
								<Setter TargetName="headerPanelBorder" Property="Grid.Row" Value="1"/>
								<Setter TargetName="contentPanel" Property="Grid.Row" Value="0"/>
							</Trigger>
							<Trigger Property="TabControl.TabStripPlacement" Value="Left">
								<Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
								<Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
								<Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto"/>
								<Setter TargetName="ColumnDefinition1" Property="Width" Value="*"/>
								<Setter TargetName="headerPanelBorder" Property="Grid.Column" Value="0"/>
								<Setter TargetName="headerPanelBorder" Property="Grid.Row" Value="0"/>
								<Setter TargetName="contentPanel" Property="Grid.Column" Value="1"/>
								<Setter TargetName="contentPanel" Property="Grid.Row" Value="0"/>
							</Trigger>
							<Trigger Property="TabControl.TabStripPlacement" Value="Right">
								<Setter TargetName="RowDefinition0" Property="Height" Value="*"/>
								<Setter TargetName="RowDefinition1" Property="Height" Value="0"/>
								<Setter TargetName="ColumnDefinition0" Property="Width" Value="*"/>
								<Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto"/>
								<Setter TargetName="headerPanelBorder" Property="Grid.Column" Value="1"/>
								<Setter TargetName="headerPanelBorder" Property="Grid.Row" Value="0"/>
								<Setter TargetName="contentPanel" Property="Grid.Column" Value="0"/>
								<Setter TargetName="contentPanel" Property="Grid.Row" Value="0"/>
							</Trigger>
						</ControlTemplate.Triggers>

					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<wpf:CommandProxy x:Key="CloseTabCommand" Command="{Binding CloseTabCommand}"/>

		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:TypedUIObjectService Name="UserControl"/>
		<b:DispatcherServiceEx/>
		<b:LoadedService Command="{Binding LoadedCommand}" OnlyOnce="True"/>

		<bf:DialogService x:Name="AppSettingsDialog"
			ContentType="{x:Type bf:AppSettingsDialog}"
			ShowDialogWindow="False"
			SingleInstance="True"/>

	</dxmvvm:Interaction.Behaviors>

	<Grid>

		<DockPanel>
			<Border Padding="4" Background="{DynamicResource RegionBrush}" DockPanel.Dock="Left">
				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
						<Button x:Name="SiteButton"
							Style="{StaticResource ButtonDefault}"
							Width="32"
							Height="32"
							Padding="0"
							ToolTip="Click to switch site">
							<Button.Background>
								<ImageBrush d:ImageSource="/BaseFramework;component/Resources/Icons/E621.png" ImageSource="{Binding ViewParameter.ModuleType, Converter={StaticResource ModuleTypeIconConverter}}"/>
							</Button.Background>
						</Button>

						<Border Style="{StaticResource VerticalSeparator}"/>

						<Button x:Name="SearchButton"
							Style="{DynamicResource Button.Custom.Icon}"
							Width="32"
							Height="32"
							ToolTip="Search">
							<wpf:FontIcon Text="&#xE721;"/>
						</Button>

					</wpf:SpacingStackPanel>

					<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}" Grid.Row="1">

						<Button
							Style="{DynamicResource Button.Custom.Icon}"
							Width="32"
							Height="32"
							Command="{Binding SwitchThemeCommand}"
							ToolTip="Switch Theme">
							<wpf:FontIcon Text="&#xF08C;"/>
						</Button>

						<Button x:Name="UserButton"
							Style="{DynamicResource Button.Custom.Icon}"
							Width="32"
							Height="32"
							ToolTip="User">
							<Grid>
								<wpf:FontIcon d:Text="&#xEA8C;" Visibility="{Binding UserService.IsUserLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
									<wpf:FontIcon.Style>
										<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource FontIconBase}">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
													<Setter Property="Text" Value="&#xEA8C;"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
													<Setter Property="Text" Value="&#xE77B;"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</wpf:FontIcon.Style>
								</wpf:FontIcon>
								<Border Visibility="{Binding UserService.IsUserLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
									<!--<ProgressBar
										Width="20"
										Height="8"
										BorderThickness="0"
										Background="White"
										IsIndeterminate="True"/>-->
									<hc:CircleProgressBar Width="20" Height="20" IsIndeterminate="True"/>
								</Border>
							</Grid>
						</Button>

						<Button
							Style="{DynamicResource Button.Custom.Icon}"
							Width="32"
							Height="32"
							Command="{Binding ShowAppSettingsDialogCommand}"
							ToolTip="Settings">
							<wpf:FontIcon Text="&#xE713;"/>
						</Button>

						<!--<Button
							Style="{DynamicResource Button.Custom.Icon}"
							Width="32"
							Height="32"
							Command="{Binding ShowAppSettingsDialogCommand}"
							ToolTip="About">
							<wpf:FontIcon Text="&#xE946;"/>
						</Button>-->

						<StackPanel>
							<!-- Text="{Binding Source={x:Static bf:AppConfig.Version}}" -->
							<TextBlock
								d:Text="1.0.0"
								FontSize="10"
								Text="{Binding AppManager.AppVersion.ShortVersion}"
								TextAlignment="Center"/>
							<TextBlock
								FontSize="10"
								Text="Debug"
								TextAlignment="Center"
								Visibility="{Binding Source={x:Static bf:AppConfig.IsRelease}, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
						</StackPanel>

					</wpf:SpacingStackPanel>

				</Grid>
			</Border>

			<Border Visibility="{Binding Tabs.Count, Converter={StaticResource IListToVisibilityConverter}}">

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Border>
						<TabControl
							Style="{StaticResource TabControlBaseStyle.Custom}"
							Margin="0"
							Padding="0"
							BorderThickness="1,0,0,0"
							dd:DragDrop.IsDragSource="True"
							dd:DragDrop.IsDropTarget="True"
							Background="{DynamicResource RegionBrush}"
							SelectedIndex="{Binding TabSelectedIndex, Mode=TwoWay}"
							TabStripPlacement="Top"
							ItemsSource="{Binding Tabs}"
							d:ItemsSource="{d:SampleData ItemCount=15}">

							<TabControl.ItemContainerStyle>
								<Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle.Custom}">
									<Setter Property="ContextMenu">
										<Setter.Value>
											<ContextMenu>
												<MenuItem bf:IconExtension.Glyph="&#xE711;" Header="Close"/>
											</ContextMenu>
										</Setter.Value>
									</Setter>
								</Style>
							</TabControl.ItemContainerStyle>

							<TabControl.ItemTemplate>
								<DataTemplate>
									<Grid MinWidth="100" Margin="1">
										<DockPanel>
											<StackPanel Name="buttonPanel" DockPanel.Dock="Right" Visibility="Visible">
												<Button Name="CloseTabButton"
													Style="{StaticResource CustomButtonStyle.Danger}"
													Width="14"
													Height="14"
													Margin="2,0,0,0"
													Padding="2"
													VerticalAlignment="Top"
													BorderThickness="0"
													Cursor="Hand"
													ToolTip="Close this tab">
													<wpf:FontIcon VerticalAlignment="Top" FontSize="10" Text="&#xE711;"/>
												</Button>
											</StackPanel>

											<!--<Rectangle Name="indicator"
												Width="3"
												Height="12"
												Margin="4,0,0,4"
												VerticalAlignment="Bottom"
												Fill="{DynamicResource PrimaryTextBrush}"
												RadiusX="1.5"
												RadiusY="1.5"/>-->

											<Border Name="iconPanel" Margin="4,0,0,2" VerticalAlignment="Bottom">
												<wpf:FontIcon Text="&#xF157;"/>
											</Border>

											<TextBlock Margin="4,0,0,2" VerticalAlignment="Bottom" Text="{Binding Tags, Converter={StaticResource TagsDisplayConverter}}"/>
										</DockPanel>

										<wpf:ButtonPopup SourceButton="{Binding ElementName=CloseTabButton}">
											<Border Style="{DynamicResource ButtonPopupBorder}">
												<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">
													<TextBlock Text="Sure to close this tab?"/>
													<Button Padding="4,2" Command="{StaticResource CloseTabCommand}" CommandParameter="{Binding}">
														<TextBlock Text="Confirm"/>
													</Button>
												</wpf:SpacingStackPanel>
											</Border>
										</wpf:ButtonPopup>
									</Grid>

									<DataTemplate.Triggers>

										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}" Value="False"/>
												<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsMouseOver}" Value="False"/>
											</MultiDataTrigger.Conditions>
											<Setter TargetName="buttonPanel" Property="Visibility" Value="Hidden"/>
										</MultiDataTrigger>

									</DataTemplate.Triggers>

								</DataTemplate>
							</TabControl.ItemTemplate>

							<TabControl.ContentTemplate>
								<DataTemplate>
									<!--<ContentControl Content="{Binding View}"/>-->
									<Border x:Name="PART_Border">
										<!--<local:PostsView dxmvvm:ViewModelExtensions.Parameter="{Binding ElementName=PART_Border, Path=DataContext}" dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}"/>-->
										<ContentControl
											Content="{Binding View}"
											Focusable="False"
											IsTabStop="False"
											Visibility="Visible"/>
									</Border>
								</DataTemplate>
							</TabControl.ContentTemplate>

							<!--<TabItem>
					<TabItem.Header>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Default" VerticalAlignment="Center" Margin="0,0,2,0"/>
							<Button Padding="2" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Cursor="Hand" Margin="2,0,0,0">
								<c:FontIcon Text="&#xE711;"/>
							</Button>
						</StackPanel>
					</TabItem.Header>
					<ContentControl Content="{Binding PostsViewModel.View}"/>
				</TabItem>-->

						</TabControl>
					</Border>

					<Border Grid.Row="1">
						<!-- Dock Panels: Download progress -->
					</Border>

				</Grid>

			</Border>
		</DockPanel>

		<wpf:ButtonPopup
			HorizontalOffset="8"
			Placement="Right"
			SourceButton="{Binding ElementName=UserButton}"
			StaysOpen="False">
			<wpf:ButtonPopup.Style>
				<Style TargetType="wpf:ButtonPopup">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
							<Setter Property="VerticalOffset" Value="-115"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
							<Setter Property="VerticalOffset" Value="-90"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</wpf:ButtonPopup.Style>
			<Border Style="{DynamicResource ButtonPopupBorder}">
				<Grid>
					<Border Visibility="{Binding IsLoggedIn, Converter={StaticResource Boolean2VisibilityReConverter}}">
						<subs:UserLogin ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
					</Border>
					<Border Visibility="{Binding IsLoggedIn, Converter={StaticResource Boolean2VisibilityConverter}}">
						<subs:UserView ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
					</Border>
				</Grid>
			</Border>
		</wpf:ButtonPopup>

		<!-- Placement="Right" HorizontalOffset="6" -->
		<wpf:ButtonPopup x:Name="SearchPopup"
			SourceButton="{Binding ElementName=SearchButton}"
			StaysOpen="False"
			VerticalOffset="4">
			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService Name="SearchPopupService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border Style="{DynamicResource ButtonPopupBorder}" MinWidth="300">
				<subs:SearchView dxmvvm:ViewModelExtensions.ParentViewModel="{Binding Source={StaticResource ViewModel}, Path=Data}" ex:ViewInitializeExtension.ViewParameter="{Binding Source={StaticResource ViewModel}, Path=Data.ViewParameter}"/>
			</Border>
		</wpf:ButtonPopup>

		<wpf:ButtonPopup x:Name="SitePopup"
			HorizontalOffset="8"
			Placement="Right"
			SourceButton="{Binding ElementName=SiteButton}">
			<dxmvvm:Interaction.Behaviors>
				<b:TypedUIObjectService Name="SitePopupService"/>
			</dxmvvm:Interaction.Behaviors>

			<Border Style="{DynamicResource ButtonPopupBorder}">
				<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}">

					<Button
						Style="{StaticResource ButtonDynamicStyle}"
						Width="90"
						Height="40"
						Padding="4"
						HorizontalContentAlignment="Left"
						Command="{Binding ShowE621Command}"
						IsEnabled="{Binding ViewParameter.ModuleType, Converter={StaticResource EnumToBoolReConverter}, ConverterParameter={x:Static bf:ModuleType.E621}}">
						<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}">
							<Border Width="32" Height="32" CornerRadius="4">
								<Border.Background>
									<ImageBrush ImageSource="{Binding Source={x:Static bf:ModuleType.E621}, Converter={StaticResource ModuleTypeIconConverter}}"/>
								</Border.Background>
							</Border>
							<TextBlock
								FontSize="16"
								FontWeight="Bold"
								Foreground="#01549d"
								Text="E621"/>
						</wpf:SpacingStackPanel>
					</Button>

					<Button
						Style="{StaticResource ButtonDynamicStyle}"
						Width="90"
						Height="40"
						Padding="4"
						HorizontalContentAlignment="Left"
						Command="{Binding ShowE926Command}"
						IsEnabled="{Binding ViewParameter.ModuleType, Converter={StaticResource EnumToBoolReConverter}, ConverterParameter={x:Static bf:ModuleType.E926}}">
						<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}">
							<Border Width="32" Height="32" CornerRadius="4">
								<Border.Background>
									<ImageBrush ImageSource="{Binding Source={x:Static bf:ModuleType.E926}, Converter={StaticResource ModuleTypeIconConverter}}"/>
								</Border.Background>
							</Border>
							<TextBlock FontSize="16" FontWeight="Bold" Text="E926"/>
						</wpf:SpacingStackPanel>
					</Button>

					<Button
						Style="{StaticResource ButtonDynamicStyle}"
						Width="90"
						Height="40"
						Padding="4"
						HorizontalContentAlignment="Left"
						Command="{Binding ShowE6AICommand}"
						IsEnabled="{Binding ViewParameter.ModuleType, Converter={StaticResource EnumToBoolReConverter}, ConverterParameter={x:Static bf:ModuleType.E6AI}}">
						<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}">
							<Border Width="32" Height="32" CornerRadius="4">
								<Border.Background>
									<ImageBrush ImageSource="{Binding Source={x:Static bf:ModuleType.E6AI}, Converter={StaticResource ModuleTypeIconConverter}}"/>
								</Border.Background>
							</Border>
							<TextBlock
								FontSize="16"
								FontWeight="Bold"
								Foreground="#fcc02e"
								Text="E6AI"/>
						</wpf:SpacingStackPanel>
					</Button>

				</wpf:SpacingStackPanel>
			</Border>
		</wpf:ButtonPopup>

		<!--<MediaElement x:Name="MeidaElement" LoadedBehavior="Play" Source="https://static1.e621.net/data/27/0f/270f73fbce4199b3b05c110b0b33274e.webm" />-->
		<!--<MediaElement LoadedBehavior="Play" Source="https://static1.e621.net/data/18/50/18504494e372a85c70a917b8bbef9de6.gif" />-->
		<!--<MediaElement LoadedBehavior="Play" Source="https://static1.e621.net/data/91/3d/913d9dd37fa6d5a3cef1e8e91ef79873.gif" />-->
		<!--<bf:GifImageControl x:Name="MainImage" Height="500" Width="500" Stretch="UniformToFill"/>-->
		<!-- gif:ImageBehavior.AnimatedSource="https://static1.e621.net/data/91/3d/913d9dd37fa6d5a3cef1e8e91ef79873.gif" -->

	</Grid>



</UserControl>
