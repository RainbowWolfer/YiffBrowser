<UserControl
	x:Class="YB.E621.Views.Subs.VideoDisplayer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
	xmlns:local="clr-namespace:YB.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<Grid>
		<fl:FlyleafHost x:Name="FlyleafHost"
			DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:VideoDisplayer}}"
			AttachedDragMove="None"
			DetachedDragMove="None"
			KeyBindings="None"
			ToggleFullScreenOnDoubleClick="None">
			<Grid DataContext="{Binding HostDataContext}" Background="Transparent" Visibility="{Binding ShowControls, Converter={StaticResource Boolean2VisibilityConverter}}">

				<bf:SliderEx
					Style="{StaticResource Slider.Playback}"
					Width="450"
					Height="420"
					Margin="20"
					VerticalAlignment="Bottom"
					Maximum="{Binding Player.Duration}"
					Background="#01FFFFFF"
					IsMoveToPointEnabled="True"
					LargeChange="{Binding Player.Config.Player.SeekOffset2}"
					PreviewMouseLeftButtonDown="Slider_DragStarted"
					PreviewMouseLeftButtonDown2="Slider_DragStarted"
					PreviewMouseLeftButtonUp="Slider_DragCompleted"
					SmallChange="{Binding Player.Config.Player.SeekOffset}"
					ValueChanged="SliderEx_ValueChanged"
					Value="{Binding Player.CurTime}"/>

				<StackPanel Orientation="Horizontal">
					<Button Command="{Binding Player.Commands.Play}" Content="Play"/>
					<Button Command="{Binding Player.Commands.Pause}" Content="Pause"/>
					<!--<Button Command="{Binding Player.Commands.Stop}" Content="Stop"/>-->
					<!--<Button Command="{Binding Player.Commands.TogglePlayPause}" Content="TogglePlayPause"/>-->
					<!--<Button Command="{Binding Player.Commands.ToggleReversePlayback}" Content="ToggleReversePlayback"/>-->
				</StackPanel>

			</Grid>
		</fl:FlyleafHost>

		<!--<MediaElement Name="MediaElement"/>-->
	</Grid>

</UserControl>
