<UserControl
	x:Class="YB.E621.Views.Subs.SearchView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:c="clr-namespace:YB.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:local="clr-namespace:YB.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:SearchViewModel}"
	d:DesignHeight="250"
	d:DesignWidth="200"
	DataContext="{b:DISource Type=local:SearchViewModel}"
	mc:Ignorable="d">

	<Control.Resources>
		<wpf:CommandProxy x:Key="HandleItemCommand" Command="{Binding HandleItemCommand}"/>


		<Style x:Key="CustomListBoxItemStyle.Local" TargetType="{x:Type ListBoxItem}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListBoxItem}">
						<wpf:ClippingBorder x:Name="Bd"
							Padding="0"
							BorderThickness="1"
							BorderBrush="Transparent"
							Background="Transparent"
							CornerRadius="4"
							SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True"/>
						</wpf:ClippingBorder>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Control.Resources>

	<dxmvvm:Interaction.Behaviors>
		<b:DispatcherServiceEx/>
		<b:LoadedService Command="{Binding LoadedCommand}"/>
	</dxmvvm:Interaction.Behaviors>

	<Grid>
		<StackPanel>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="auto"/>
				</Grid.ColumnDefinitions>

				<bf:TextBoxExtend x:Name="SearchBox"
					Style="{StaticResource TextBoxExtend}"
					bf:ControlExtension.LoadedCommand="{Binding OnSearchTextBoxLoadedCommand}"
					bf:ControlExtension.PreviewKeyDownCommand="{Binding OnSearchTextBoxPreviewKeyDownCommand}"
					bf:TextBoxExtension.SelectionChangedCommand="{Binding OnSearchTextSelectionChangedCommand}"
					AcceptsReturn="False"
					AcceptsTab="False"
					BindableSelectionStart="{Binding SearchTextSelectionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<dxmvvm:Interaction.Behaviors>
						<b:TypedUIObjectService Name="SearchBoxService"/>
					</dxmvvm:Interaction.Behaviors>
				</bf:TextBoxExtend>

				<Button
					Style="{StaticResource Button.Custom.Icon}"
					Grid.Column="1"
					Width="30"
					Margin="4,0,0,0"
					Padding="0"
					Command="{Binding ClearCommand}"
					DockPanel.Dock="Right"
					ToolTip="Clear">
					<wpf:FontIcon Text="&#xE711;"/>
				</Button>

				<Button
					Style="{StaticResource Button.Custom.Icon}"
					Grid.Column="2"
					Width="30"
					Margin="4,0,0,0"
					Padding="0"
					Command="{Binding SubmitCommand}"
					DockPanel.Dock="Right"
					ToolTip="Search">
					<wpf:FontIcon Text="&#xE721;"/>
				</Button>

				<Button
					Style="{StaticResource Button.Custom.Icon}"
					Grid.Column="3"
					Width="30"
					Margin="4,0,0,0"
					Padding="0"
					Command="{Binding OpenSearchPanelCommand}"
					DockPanel.Dock="Right"
					ToolTip="Open Search Panel">
					<wpf:FontIcon Text="&#xE8A7;"/>
				</Button>

			</Grid>

			<Border>
				<Grid>
					<ListBox x:Name="MainListBox"
						Margin="0,4,0,0"
						Padding="2"
						bf:ListBoxExtension.ClickBlankToDeselect="True"
						bf:ListBoxExtension.EscapeToDeselect="True"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
						Visibility="{Binding AutoCompletes.Count, Converter={StaticResource IListToVisibilityConverter}}"
						ItemsSource="{Binding AutoCompletes}"
						d:ItemsSource="{d:SampleData ItemCount=3}">

						<dxmvvm:Interaction.Behaviors>
							<b:TypedUIObjectService Name="MainListBoxService"/>
						</dxmvvm:Interaction.Behaviors>

						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem" BasedOn="{StaticResource CustomListBoxItemStyle.Local}">
								<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
								<Setter Property="bf:ControlExtension.DoubleClickCommand" Value="{StaticResource HandleItemCommand}"/>
								<Setter Property="bf:ControlExtension.DoubleClickCommandParameter" Value="{Binding}"/>
							</Style>
						</ListBox.ItemContainerStyle>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<c:SearchTagItemControl AutoComplete="{Binding AutoComplete}" IsSelected="{Binding IsSelected, Mode=TwoWay}"/>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>

					<StackPanel>
						<ProgressBar
							Height="6"
							Margin="0,4,0,0"
							VerticalAlignment="Top"
							BorderThickness="0"
							IsIndeterminate="True"
							Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}"/>

						<TextBlock
							Margin="0,4,0,0"
							VerticalAlignment="Top"
							FontSize="14"
							Text="{Binding AlternativeHintText}"
							TextAlignment="Center"
							Visibility="{Binding AlternativeHintText, Converter={StaticResource String2VisibilityConverter}}"/>

					</StackPanel>

				</Grid>
			</Border>
		</StackPanel>
	</Grid>

</UserControl>
