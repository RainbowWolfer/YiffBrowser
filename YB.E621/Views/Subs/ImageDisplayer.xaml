<UserControl x:Name="Root"
	x:Class="YB.E621.Views.Subs.ImageDisplayer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:c="clr-namespace:YB.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DesignHeight="250"
	d:DesignWidth="400"
	mc:Ignorable="d">

	<Control.Resources>

	</Control.Resources>

	<Grid DataContext="{Binding ElementName=Root}">
		<Grid>

			<Border>
				<Grid>
					<bf:ImageViewer x:Name="ImageViewer"
						BorderThickness="0"
						IsEnabled="{Binding IsFileReady}"
						MouseDoubleClick="ImageViewer_MouseDoubleClick"
						MouseUp="ImageViewer_MouseUp"/>
					<d:Image Source="/BaseFramework;component/Resources/Temp/Temp1.jpg" Stretch="UniformToFill"/>
				</Grid>
			</Border>

			<c:LoadingProgresControl
				Margin="4"
				VerticalAlignment="Top"
				wpf:ToolTipExtension.FastToolTip="True"
				DownloadInfo="{Binding LoadingStatus.DownloadInfo}"
				ErrorMessage="{Binding LoadingStatus.ErrorMessage}"
				Progress="{Binding LoadingStatus.Progress}"
				ReloadCommand="{Binding ReloadCommand}"
				ToolTip="{Binding LoadingStatus.ToolTip}"
				Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}"/>

		</Grid>
	</Grid>
</UserControl>
