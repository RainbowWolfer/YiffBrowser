<UserControl
	x:Class="YB.E621.Views.Subs.UserView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:BaseFramework.Controls;assembly=BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Views.Subs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="clr-namespace:BaseFramework.Views;assembly=BaseFramework"
	xmlns:wpf="RW.Common.WPF"
	d:Background="LightGray"
	d:DataContext="{d:DesignInstance Type=local:UserViewModel}"
	Width="200"
	Height="auto"
	mc:Ignorable="d">

	<Control.Resources>
		<ResourceDictionary Source="pack://application:,,,/YB.E621;component/Resources/Generic.xaml"/>
	</Control.Resources>

	<Grid>
		<wpf:SpacingStackPanel Style="{StaticResource CustomVerticalPanel2}" Margin="2">

			<StackPanel>
				<c:HorizontalIconText Margin="4,2" Glyph="&#xE723;" Text="User ID"/>
				<Border
					Padding="4,1"
					BorderBrush="LightGray"
					Background="White"
					CornerRadius="4">
					<TextBlock d:Text="123456" Text="{Binding User.Id}"/>
				</Border>
			</StackPanel>

			<StackPanel>
				<c:HorizontalIconText Margin="4,2" Glyph="&#xE8D4;" Text="Username"/>
				<Border
					Padding="4,1"
					BorderBrush="LightGray"
					Background="White"
					CornerRadius="4">
					<TextBlock d:Text="Username" Text="{Binding User.Name}"/>
				</Border>
			</StackPanel>

			<StackPanel>
				<c:HorizontalIconText Margin="4,2" Glyph="&#xE715;" Text="Email"/>
				<Border
					Padding="4,1"
					BorderBrush="LightGray"
					Background="White"
					CornerRadius="4">
					<TextBlock d:Text="Username@email.com" Text="{Binding User.Email}"/>
				</Border>
			</StackPanel>

			<Grid>
				<Button Command="{Binding LogoutCommand}">
					<TextBlock Text="Logout"/>
				</Button>
			</Grid>

		</wpf:SpacingStackPanel>
	</Grid>

</UserControl>
