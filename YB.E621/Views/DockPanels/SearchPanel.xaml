<UserControl
	x:Class="YB.E621.Views.DockPanels.SearchPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YB.E621.Views.DockPanels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:SearchPanelViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="800"
	DataContext="{b:DISource Type=local:SearchPanelViewModel}"
	mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="1">

			<bf:TextBoxExtend x:Name="SearchBox"
				Style="{StaticResource TextBoxExtend}"
				bf:ControlExtension.LoadedCommand="{Binding OnSearchTextBoxLoadedCommand}"
				bf:ControlExtension.PreviewKeyDownCommand="{Binding OnSearchTextBoxPreviewKeyDownCommand}"
				bf:TextBoxExtension.SelectionChangedCommand="{Binding OnSearchTextSelectionChangedCommand}"
				AcceptsReturn="False"
				AcceptsTab="False"
				BindableSelectionStart="{Binding SearchTextSelectionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				Text="{Binding SearchTe xt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
				<dxmvvm:Interaction.Behaviors>
					<b:TypedUIObjectService Name="SearchBoxService"/>
				</dxmvvm:Interaction.Behaviors>
			</bf:TextBoxExtend>

		</Border>

	</Grid>

</UserControl>
