<UserControl
	x:Class="YB.E621.Views.DockPanels.SearchHistoryPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:YB.E621.Views.DockPanels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:SearchHistoryPanelViewModel}"
	d:DesignHeight="300"
	d:DesignWidth="800"
	DataContext="{b:DISource Type=local:SearchHistoryPanelViewModel}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<wpf:CommandProxy x:Key="CopyRecordCommand" Command="{Binding CopyRecordCommand}"/>
		<wpf:CommandProxy x:Key="SearchRecordCommand" Command="{Binding SearchRecordCommand}"/>
		<wpf:CommandProxy x:Key="DeleteSelectedCommand" Command="{Binding DeleteSelectedCommand}"/>
		<wpf:CommandProxy x:Key="ConfirmDeleteCommand" Command="{Binding ConfirmDeleteCommand}"/>
	</UserControl.Resources>

	<Grid Margin="4">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0">
			<DockPanel>
				<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}" Margin="4">
					<Button Command="{Binding GotoSearchPanelCommand}" ToolTip="Goto Search Panel">
						<bf:HorizontalIconText Glyph="&#xE721;" Text="Search Panel"/>
					</Button>

					<Button Command="{Binding RefreshCommand}" ToolTip="Refresh">
						<wpf:FontIcon Text="&#xE72C;"/>
					</Button>

					<hc:SearchBar
						Style="{StaticResource SearchBarPlus}"
						Width="250"
						hc:InfoElement.Placeholder="Search Content"
						hc:InfoElement.ShowClearButton="True"
						Text="{Binding SearchCondition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

				</wpf:SpacingStackPanel>

				<hc:Pagination
					d:MaxPageCount="100"
					Margin="4"
					HorizontalAlignment="Right"
					IsEnabled="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2BooleanReConverter}}"
					MaxPageCount="{Binding MaxPageCount}"
					MaxPageInterval="4"
					PageIndex="{Binding PageIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			</DockPanel>
		</Border>

		<Border Grid.Row="1">
			<Grid>

				<DataGrid
					Style="{StaticResource DataGrid.Custom}"
					Margin="4"
					bf:SelectorExtension.SelectedItems="{Binding SelectedRecordList}"
					wpf:DataGridExtension.CanUnselectAllWidthEscape="True"
					wpf:DataGridExtension.CanUnselectAllWithBlankArea="True"
					AutoGenerateColumns="False"
					IsReadOnly="True"
					SelectionMode="Extended"
					SelectionUnit="FullRow"
					ItemsSource="{Binding RecordList}">

					<DataGrid.Columns>
						<DataGridTextColumn Width="180" Binding="{Binding DateTime}" Header="Date Time"/>
						<DataGridTextColumn Width="*" Binding="{Binding Tags, Converter={StaticResource TagsDisplayConverter}}" Header="Content"/>
						<DataGridTemplateColumn Width="200" Header="Action">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel3}">

											<Button
												Padding="2,0"
												BorderThickness="0"
												bf:ButtonExtension.SetPreviewClick="True"
												Background="Transparent"
												Command="{StaticResource SearchRecordCommand}"
												CommandParameter="{Binding}">
												<bf:HorizontalIconText Glyph="&#xE721;" Text="Search"/>
											</Button>

											<Button
												Padding="2,0"
												BorderThickness="0"
												bf:ButtonExtension.SetPreviewClick="True"
												Background="Transparent"
												Command="{StaticResource CopyRecordCommand}"
												CommandParameter="{Binding}">
												<bf:HorizontalIconText Glyph="&#xE8C8;" Text="Copy"/>
											</Button>

											<!--<Button Name="DeleteButton"
												Padding="2,0"
												BorderThickness="0"
												bf:ButtonExtension.SetPreviewClick="True"
												Background="Transparent">
												<bf:HorizontalIconText
													Foreground="{DynamicResource DangerBrush}"
													Glyph="&#xE894;"
													IconForeground="{DynamicResource DangerBrush}"
													Text="Delete"/>
											</Button>-->

										</wpf:SpacingStackPanel>

										<!--<wpf:ButtonPopup SourceButton="{Binding ElementName=DeleteButton}">
											<Border Style="{DynamicResource ButtonPopupBorder}">
												<StackPanel>
													<TextBlock Text="Sure to delete this record?"/>
													<Button Margin="0,4,0,0" HorizontalAlignment="Stretch" Content="Confirm"/>
												</StackPanel>
											</Border>
										</wpf:ButtonPopup>-->

									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>

					<DataGrid.RowStyle>
						<Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRow.Custom}">
							<Setter Property="ContextMenu">
								<Setter.Value>
									<ContextMenu>
										<MenuItem
											bf:IconExtension.Glyph="&#xE8C8;"
											Command="{StaticResource CopyRecordCommand}"
											CommandParameter="{Binding}"
											Header="Copy"/>
										<MenuItem
											bf:IconExtension.Glyph="&#xE721;"
											Command="{StaticResource SearchRecordCommand}"
											CommandParameter="{Binding}"
											Header="Search"/>
										<Separator/>
										<MenuItem bf:IconExtension.Glyph="&#xE894;" Command="{StaticResource DeleteSelectedCommand}" Header="Delete Selected"/>
									</ContextMenu>
								</Setter.Value>
							</Setter>
						</Style>
					</DataGrid.RowStyle>

				</DataGrid>

				<Border HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoadingStatus.ShowLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
					<ProgressBar Width="150" Height="8" IsIndeterminate="True"/>
				</Border>

				<Border HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoadingStatus.ErrorMessage, Converter={StaticResource String2VisibilityConverter}}">
					<TextBlock
						MaxWidth="300"
						FontSize="14"
						Foreground="{DynamicResource DangerBrush}"
						Text="{Binding LoadingStatus.ErrorMessage}"
						TextAlignment="Center"
						TextWrapping="Wrap"/>
				</Border>

				<wpf:CustomPopup Placement="Center">

					<dxmvvm:Interaction.Behaviors>
						<b:TypedUIObjectService Name="DeleteConfirmPopupService"/>
					</dxmvvm:Interaction.Behaviors>

					<Border Style="{DynamicResource ButtonPopupBorder}">
						<StackPanel Margin="4">
							<TextBlock Text="{Binding RecordListToBeDeleted.Count, StringFormat='{}Delete {0} selected records?'}"/>
							<Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{StaticResource ConfirmDeleteCommand}">
								<TextBlock Foreground="{DynamicResource DangerBrush}" Text="Confirm"/>
							</Button>
						</StackPanel>
					</Border>
				</wpf:CustomPopup>

			</Grid>
		</Border>

	</Grid>

</UserControl>
