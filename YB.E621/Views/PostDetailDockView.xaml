<UserControl
	x:Class="YB.E621.Views.PostDetailDockView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:c="clr-namespace:YB.E621.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:local="clr-namespace:YB.E621.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=local:PostDetailDockViewModel}"
	d:DesignHeight="450"
	d:DesignWidth="300"
	mc:Ignorable="d">

	<Control.Resources>

		<wpf:CommandProxy x:Key="CloseTabCommand" Command="{Binding CloseTabCommand}"/>

	</Control.Resources>

	<Grid>
		<TabControl Padding="0" BorderThickness="0,1,0,0">
			<TabItem Header="Description">
				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<ScrollViewer Padding="4">
						<Border>
							<TextBox
								d:Text="No Description"
								Style="{StaticResource SelectableTextBlock}"
								VerticalAlignment="Stretch"
								FontSize="18"
								Text="{Binding Description}"
								TextWrapping="Wrap"/>
						</Border>
					</ScrollViewer>

					<Border Grid.Row="1" Padding="4">
						<StackPanel>
							<TextBlock
								d:Text="No Source"
								Margin="4,0"
								FontSize="20"
								Text="{Binding SourceTitle}"/>
							<ListBox
								MaxHeight="200"
								Padding="0"
								BorderThickness="0"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ItemsSource="{Binding SourceURLs}">
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem" BasedOn="{StaticResource CustomListBoxItemStyle}">
										<Setter Property="Padding" Value="0"/>
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="VerticalContentAlignment" Value="Center"/>
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<!--<c:SourceHyperLinkButton URL="{Binding}" Height="30"/>-->
										<Border/>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>

			<TabItem Header="Comments 1">

			</TabItem>

			<TabItem Header="Relations">

			</TabItem>

		</TabControl>
	</Grid>

</UserControl>
