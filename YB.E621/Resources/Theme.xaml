<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="RW.Base.WPF"
	xmlns:bf="BaseFramework"
	xmlns:c="clr-namespace:YB.E621.Controls"
	xmlns:con="clr-namespace:YB.E621.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models_e621="clr-namespace:YB.E621.Models.E621"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
	xmlns:system="clr-namespace:System;assembly=netstandard"
	xmlns:wpf="RW.Common.WPF"
	mc:Ignorable="d">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/BaseFramework;component/Resources/Theme.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<con:TagsDisplayConverter x:Key="TagsDisplayConverter"/>
	<con:E621TagCategoryBrushConverter x:Key="E621TagCategoryBrushConverter"/>
	<con:E621RatingToBrushConverter x:Key="E621RatingToBrushConverter"/>
	<con:E621RatingToIconConverter x:Key="E621RatingToIconConverter"/>
	<con:UrlIconConverter x:Key="UrlIconConverter"/>
	<con:ModuleTypeIconConverter x:Key="ModuleTypeIconConverter"/>

	<bf:SubStringConverter x:Key="RatingHeaderConverter" Length="1" StartIndex="0"/>

	<Style TargetType="c:PostCardControl" BasedOn="{StaticResource BaseStyle}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="c:PostCardControl">
					<ControlTemplate.Resources>
						<system:Double x:Key="ScaleRatio">1.05</system:Double>

						<Storyboard x:Key="ScaleOn">
							<DoubleAnimation
								Storyboard.TargetName="Scale"
								Storyboard.TargetProperty="ScaleX"
								From="1"
								To="{StaticResource ScaleRatio}"
								EasingFunction="{StaticResource DefaultEasingFunction}"
								Duration="0:0:1"/>
							<DoubleAnimation
								Storyboard.TargetName="Scale"
								Storyboard.TargetProperty="ScaleY"
								From="1"
								To="{StaticResource ScaleRatio}"
								EasingFunction="{StaticResource DefaultEasingFunction}"
								Duration="0:0:1"/>
						</Storyboard>

						<Storyboard x:Key="ScaleOff">
							<DoubleAnimation
								Storyboard.TargetName="Scale"
								Storyboard.TargetProperty="ScaleX"
								From="{StaticResource ScaleRatio}"
								To="1"
								EasingFunction="{StaticResource DefaultEasingFunction}"
								Duration="0:0:1"/>
							<DoubleAnimation
								Storyboard.TargetName="Scale"
								Storyboard.TargetProperty="ScaleY"
								From="{StaticResource ScaleRatio}"
								To="1"
								EasingFunction="{StaticResource DefaultEasingFunction}"
								Duration="0:0:1"/>
						</Storyboard>

					</ControlTemplate.Resources>

					<wpf:ClippingBorder Name="RootBorder"
						BorderThickness="2"
						BorderBrush="{DynamicResource BorderBrush}"
						CornerRadius="8">

						<DockPanel>

							<Border Name="BottomBorder"
								Padding="4,2"
								Background="{DynamicResource BorderBrush}"
								CornerRadius="0"
								DockPanel.Dock="Bottom">
								<Grid DataContext="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Post}" Margin="10,0">

									<Grid.Resources>
										<Style TargetType="bf:HorizontalIconText" BasedOn="{StaticResource HorizontalIconTextBaseStyle}">
											<Setter Property="HorizontalAlignment" Value="Center"/>
											<Setter Property="IconSize" Value="14"/>
										</Style>
									</Grid.Resources>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0">
										<bf:HorizontalIconText Glyph="&#xE878;" Text="{Binding Score.Total}"/>
									</Border>

									<Border Grid.Column="1">
										<bf:HorizontalIconText Glyph="&#xEB52;" Text="{Binding FavCount}"/>
									</Border>

									<Border Grid.Column="2">
										<bf:HorizontalIconText Glyph="&#xE90A;" Text="{Binding CommentCount}"/>
									</Border>

									<Border Grid.Column="3">
										<bf:HorizontalIconText Glyph="{Binding Rating, Converter={StaticResource E621RatingToIconConverter}}" IconForeground="{Binding Rating, Converter={StaticResource E621RatingToBrushConverter}}" Text="{Binding Rating, Converter={StaticResource RatingHeaderConverter}}"/>
									</Border>

								</Grid>
							</Border>

							<Grid>

								<Border ClipToBounds="True">

									<Border Background="Transparent" CornerRadius="4,4,0,0" RenderTransformOrigin="0.5,0.5">
										<Border.RenderTransform>
											<ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
										</Border.RenderTransform>
										<bf:ImageExtend
											bf:ImageExtension.GifAutoPlayType="{TemplateBinding GifAutoPlayType}"
											BitmapImage="{TemplateBinding BitmapImage}"
											GifImage="{TemplateBinding GifImage}"
											Stretch="UniformToFill"
											Visibility="Collapsed"/>
									</Border>
								</Border>

								<StackPanel>
									<ProgressBar Name="LoadingProgressBar"
										Height="6"
										BorderThickness="0"
										bf:BorderExtension.CornerRadius="4,4,0,0"
										IsIndeterminate="True"
										Value="{TemplateBinding LoadingProgress}"/>

									<Grid DataContext="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=TypeHint}" Margin="4" Visibility="{Binding Converter={StaticResource String2VisibilityConverter}}">
										<Border Padding="4,2" HorizontalAlignment="Right" CornerRadius="4">
											<Border.Background>
												<SolidColorBrush Opacity="0.5" Color="Gray"/>
											</Border.Background>
											<Border.Effect>
												<DropShadowEffect
													BlurRadius="6"
													Opacity="0.5"
													ShadowDepth="4"
													Color="Black"/>
											</Border.Effect>

											<TextBlock FontSize="16" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding}"/>

										</Border>
									</Grid>


								</StackPanel>

							</Grid>

						</DockPanel>
					</wpf:ClippingBorder>

					<ControlTemplate.Triggers>
						<Trigger Property="LoadingStatus" Value="HasCompleted">
							<Setter TargetName="LoadingProgressBar" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="LoadingStatus" Value="HasError">
							<Setter TargetName="LoadingProgressBar" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="LoadingStatus" Value="Loading">
							<Setter TargetName="LoadingProgressBar" Property="Visibility" Value="Visible"/>
							<Setter TargetName="LoadingProgressBar" Property="IsIndeterminate" Value="False"/>
						</Trigger>
						<Trigger Property="LoadingStatus" Value="NotStarted">
							<Setter TargetName="LoadingProgressBar" Property="Visibility" Value="Visible"/>
							<Setter TargetName="LoadingProgressBar" Property="IsIndeterminate" Value="True"/>
						</Trigger>
						<!--<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=IsSelected}" Value="True"/>
								<Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=c:PostCardListBox},Path=AllowSelection}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter TargetName="RootBorder" Property="BorderBrush" Value="Orange"/>
							<Setter TargetName="BottomBorder" Property="Background" Value="Orange"/>
						</MultiDataTrigger>-->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
							<Setter TargetName="BottomBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
						</Trigger>
						<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=c:PostCardListBox}, Path=AllowSelection}" Value="False">
							<Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
							<Setter TargetName="BottomBorder" Property="Background" Value="{DynamicResource BorderBrush}"/>
						</DataTrigger>
					</ControlTemplate.Triggers>

				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>


	<Style TargetType="c:SearchTagItemControl">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="c:SearchTagItemControl">
					<Border x:Name="RootBorder" BorderThickness="1" BorderBrush="{TemplateBinding MainBrush}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="auto"/>
							</Grid.ColumnDefinitions>

							<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

								<Rectangle Name="CategoryRectangle"
									Width="4"
									Height="23"
									VerticalAlignment="Center"
									Fill="{TemplateBinding MainBrush}"
									RadiusX="2"
									RadiusY="2"/>

								<TextBlock Margin="10,0,10,0" VerticalAlignment="Center" Text="{TemplateBinding FromName}"/>

								<StackPanel Orientation="Horizontal" Visibility="{TemplateBinding ToName, Converter={StaticResource String2VisibilityConverter}}">
									<wpf:FontIcon VerticalAlignment="Center" FontSize="12" Text="&#xEA62;"/>
									<TextBlock Margin="10,0,10,0" VerticalAlignment="Center" Text="{TemplateBinding ToName}"/>
								</StackPanel>

							</StackPanel>

							<StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
								<TextBlock Margin="10,0,10,0" VerticalAlignment="Center" Text="{TemplateBinding CountString}"/>
							</StackPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="CategoryRectangle" Property="Width" Value="6"/>
							<Setter TargetName="CategoryRectangle" Property="RadiusX" Value="0"/>
							<Setter TargetName="CategoryRectangle" Property="RadiusY" Value="0"/>
						</Trigger>
						<Trigger Property="IsSelected" Value="False">
							<Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>





	<ControlTemplate x:Key="WindowWin10Template.Custom" TargetType="hc:Window">
		<Border Background="#01FFFFFF" SnapsToDevicePixels="True">
			<Border
				Margin="0"
				BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}">
				<Grid Margin="{TemplateBinding Padding}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition/>
					</Grid.RowDefinitions>
					<Grid Name="PART_NonClientArea" Background="{TemplateBinding NonClientAreaBackground}" TextElement.Foreground="{TemplateBinding NonClientAreaForeground}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel Name="ButtonPanel"
							Grid.Column="1"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							shell:WindowChrome.IsHitTestVisibleInChrome="True"
							Orientation="Horizontal"
							UseLayoutRounding="True">
							<Button Name="ButtonMin"
								Style="{StaticResource ButtonIcon}"
								Width="45"
								Height="29"
								BorderThickness="1,0,1,0"
								hc:IconElement.Geometry="{StaticResource WindowMinGeometry}"
								hc:IconElement.Height="10"
								hc:IconElement.Width="10"
								Background="{TemplateBinding OtherButtonBackground}"
								Command="sw:SystemCommands.MinimizeWindowCommand"
								Foreground="{TemplateBinding OtherButtonForeground}"
								IsTabStop="False"/>
							<Button Name="ButtonMax"
								Style="{StaticResource ButtonIcon}"
								Width="46"
								Height="29"
								BorderThickness="1,0,1,0"
								hc:IconElement.Geometry="{StaticResource WindowMaxGeometry}"
								hc:IconElement.Height="10"
								hc:IconElement.Width="10"
								Background="{TemplateBinding OtherButtonBackground}"
								Command="sw:SystemCommands.MaximizeWindowCommand"
								Foreground="{TemplateBinding OtherButtonForeground}"
								IsTabStop="False"/>
							<Button Name="ButtonRestore"
								Style="{StaticResource ButtonIcon}"
								Width="46"
								Height="29"
								BorderThickness="1,0,1,0"
								hc:IconElement.Geometry="{StaticResource WindowRestoreGeometry}"
								hc:IconElement.Height="10"
								hc:IconElement.Width="10"
								Background="{TemplateBinding OtherButtonBackground}"
								Command="sw:SystemCommands.RestoreWindowCommand"
								Foreground="{TemplateBinding OtherButtonForeground}"
								IsTabStop="False"/>
							<Button Name="ButtonClose"
								Style="{StaticResource ButtonIcon}"
								Width="46"
								Height="29"
								BorderThickness="1,0,0,0"
								hc:IconElement.Geometry="{StaticResource CloseGeometry}"
								hc:IconElement.Height="10"
								hc:IconElement.Width="10"
								Background="{TemplateBinding CloseButtonBackground}"
								Command="sw:SystemCommands.CloseWindowCommand"
								Foreground="{TemplateBinding CloseButtonForeground}"
								IsTabStop="False"/>
						</StackPanel>
						<Grid Grid.Column="0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Button Name="ButtonIcon"
								Style="{StaticResource ButtonCustom}"
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Background="Transparent"
								Command="{x:Static sw:SystemCommands.ShowSystemMenuCommand}">
								<Button.Visibility>
									<MultiBinding Converter="{StaticResource BooleanArr2VisibilityConverter}">
										<MultiBinding.Bindings>
											<Binding Path="ShowIcon" RelativeSource="{RelativeSource TemplatedParent}"/>
											<Binding Path="Icon" Converter="{StaticResource Object2BooleanConverter}" RelativeSource="{RelativeSource TemplatedParent}"/>
										</MultiBinding.Bindings>
									</MultiBinding>
								</Button.Visibility>
								<hc:Interaction.Triggers>
									<hc:EventTrigger EventName="MouseDoubleClick">
										<hc:InvokeCommandAction Command="{x:Static sw:SystemCommands.CloseWindowCommand}"/>
									</hc:EventTrigger>
								</hc:Interaction.Triggers>
								<Image
									Width="16"
									Height="16"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Source="{TemplateBinding Icon}"/>
							</Button>
							<TextBlock
								Grid.Column="1"
								Padding="10,0,0,0"
								VerticalAlignment="Center"
								Text="{TemplateBinding Title}">
								<TextBlock.Visibility>
									<MultiBinding Converter="{StaticResource BooleanArr2VisibilityConverter}">
										<MultiBinding.Bindings>
											<Binding Path="ShowTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
											<Binding Path="Title" Converter="{StaticResource Object2BooleanConverter}" RelativeSource="{RelativeSource TemplatedParent}"/>
										</MultiBinding.Bindings>
									</MultiBinding>
								</TextBlock.Visibility>
							</TextBlock>
							<ContentPresenter x:Name="ContentPresenterMain"
								Grid.Column="2"
								shell:WindowChrome.IsHitTestVisibleInChrome="True"
								Content="{TemplateBinding NonClientAreaContent}"/>
						</Grid>
					</Grid>
					<AdornerDecorator Grid.Row="1">
						<ContentPresenter ClipToBounds="True"/>
					</AdornerDecorator>
					<ResizeGrip x:Name="ResizeGrip"
						Grid.Row="1"
						Width="10"
						Height="10"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						IsTabStop="False"
						Visibility="Collapsed"/>
				</Grid>
			</Border>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="IsActive" Value="False">
				<Setter TargetName="ContentPresenterMain" Property="Opacity" Value=".8"/>
				<Setter TargetName="ButtonPanel" Property="Opacity" Value=".8"/>
			</Trigger>
			<Trigger Property="WindowState" Value="Maximized">
				<Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ButtonRestore" Property="Visibility" Value="Visible"/>
			</Trigger>
			<Trigger Property="WindowState" Value="Normal">
				<Setter TargetName="ButtonMax" Property="Visibility" Value="Visible"/>
				<Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed"/>
			</Trigger>
			<Trigger Property="ResizeMode" Value="NoResize">
				<Setter TargetName="ButtonMin" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed"/>
			</Trigger>
			<Trigger Property="ResizeMode" Value="CanMinimize">
				<Setter TargetName="ButtonMax" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="ButtonRestore" Property="Visibility" Value="Collapsed"/>
			</Trigger>
			<Trigger SourceName="ButtonClose" Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonClose" Property="Background" Value="{Binding CloseButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
				<Setter TargetName="ButtonClose" Property="Foreground" Value="{Binding CloseButtonHoverForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
			</Trigger>
			<Trigger SourceName="ButtonMax" Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonMax" Property="Background" Value="{Binding OtherButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
				<Setter TargetName="ButtonMax" Property="Foreground" Value="{Binding OtherButtonHoverForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
			</Trigger>
			<Trigger SourceName="ButtonRestore" Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonRestore" Property="Background" Value="{Binding OtherButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
				<Setter TargetName="ButtonRestore" Property="Foreground" Value="{Binding OtherButtonHoverForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
			</Trigger>
			<Trigger SourceName="ButtonMin" Property="IsMouseOver" Value="True">
				<Setter TargetName="ButtonMin" Property="Background" Value="{Binding OtherButtonHoverBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
				<Setter TargetName="ButtonMin" Property="Foreground" Value="{Binding OtherButtonHoverForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
			</Trigger>
			<Trigger Property="WindowStyle" Value="None">
				<Setter Property="ShowNonClientArea" Value="False"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
					<Condition Property="WindowState" Value="Normal"/>
				</MultiTrigger.Conditions>
				<Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible"/>
			</MultiTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>



	<Style x:Key="WindowWin10.Custom" TargetType="hc:Window">
		<!--<Setter Property="shell:WindowChrome.WindowChrome">
			<Setter.Value>
				<shell:WindowChrome
					CaptionHeight="32"
					CornerRadius="8"
					GlassFrameThickness="0"
					ResizeBorderThickness="2"/>
			</Setter.Value>
		</Setter>-->

		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BorderBrush" Value="#262e2f"/>
		<Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="UseLayoutRounding" Value="True"/>
		<Setter Property="NonClientAreaBackground" Value="{DynamicResource RegionBrush}"/>
		<Setter Property="NonClientAreaForeground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="CloseButtonBackground" Value="Transparent"/>
		<Setter Property="CloseButtonForeground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="CloseButtonHoverBackground" Value="#e81123"/>
		<Setter Property="CloseButtonHoverForeground" Value="White"/>
		<Setter Property="OtherButtonBackground" Value="Transparent"/>
		<Setter Property="OtherButtonForeground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="OtherButtonHoverBackground" Value="{DynamicResource DarkMaskBrush}"/>
		<Setter Property="OtherButtonHoverForeground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="Template" Value="{StaticResource WindowWin10Template.Custom}"/>
	</Style>


</ResourceDictionary>