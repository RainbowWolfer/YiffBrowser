<UserControl
	x:Class="YB.E621.Controls.PostHeaderSimpleInfoView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:Background="{DynamicResource RegionBrush}"
	d:DesignHeight="50"
	d:DesignWidth="400"
	mc:Ignorable="d">

	<Control.Resources>

		<Style x:Key="IDFlyoutInfoBorderStyle" TargetType="Border">
			<Setter Property="Margin" Value="0,0,0,4"/>
			<Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

		<Style x:Key="IDFlyoutInfoTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="10,0,0,1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Grid.Column" Value="1"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>


	</Control.Resources>

	<Grid>
		<StackPanel Orientation="Horizontal">

			<Border
				Height="30"
				Padding="4,2"
				BorderThickness="1"
				BorderBrush="{DynamicResource BorderBrush}"
				Background="{DynamicResource SecondaryRegionBrush}"
				CornerRadius="4">
				<StackPanel Orientation="Horizontal">
					<Border x:Name="TypeBorder" Padding="2,0">
						<wpf:FontIcon x:Name="TypeIcon" FontSize="24" Text="&#xF4A9;"/>
					</Border>
					<TextBlock x:Name="DurationText"
						d:Visibility="Visible"
						Margin="2,0"
						VerticalAlignment="Center"
						FontSize="14"
						Foreground="{DynamicResource PrimaryTextBrush}"
						Text="1:00"
						ToolTip="Media duration"/>
				</StackPanel>
			</Border>

			<Button x:Name="PostIDButton"
				Height="30"
				MinWidth="60"
				Margin="6,0,0,0"
				Padding="6,0">
				<TextBlock x:Name="PostIDText"
					FontFamily="Cascadia Mono"
					FontSize="20"
					Text="123456 (S)"/>
			</Button>

			<Border x:Name="SoundBorder"
				Height="30"
				Margin="6,0,0,0"
				Padding="4,2"
				BorderThickness="1"
				BorderBrush="{DynamicResource BorderBrush}"
				Background="{DynamicResource SecondaryRegionBrush}"
				CornerRadius="4"
				ToolTip="This post has 'sound' tag">
				<wpf:FontIcon
					VerticalAlignment="Center"
					FontSize="20"
					Foreground="Orange"
					Text="&#xE7BA;"/>
			</Border>

			<Border x:Name="SoundWarningBorder"
				Height="30"
				Margin="6,0,0,0"
				Padding="4,2"
				BorderThickness="1"
				BorderBrush="{DynamicResource BorderBrush}"
				Background="{DynamicResource SecondaryRegionBrush}"
				CornerRadius="4"
				ToolTip="This post has 'sound_warning' tag">
				<wpf:FontIcon
					VerticalAlignment="Center"
					FontSize="20"
					Foreground="Red"
					Text="&#xE7BA;"/>
			</Border>

		</StackPanel>

		<wpf:ButtonPopup SourceButton="{Binding ElementName=PostIDButton}">
			<Border Style="{StaticResource ButtonPopupBorder}" MinWidth="280">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
						<RowDefinition Height="auto"/>
					</Grid.RowDefinitions>

					<Border Style="{StaticResource IDFlyoutInfoBorderStyle}" Grid.Row="0">
						<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
							<TextBlock Text="Created Date"/>
							<wpf:FontIcon Margin="10,0,0,0" Text="&#xEE93;"/>
						</StackPanel>
					</Border>
					<TextBlock x:Name="CreatedDateText" Style="{StaticResource IDFlyoutInfoTextStyle}" Grid.Row="0"/>

					<Border Style="{StaticResource IDFlyoutInfoBorderStyle}" Grid.Row="1">
						<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
							<TextBlock Text="Updated Date"/>
							<wpf:FontIcon Margin="10,0,0,0" Text="&#xE163;"/>
						</StackPanel>
					</Border>
					<TextBlock x:Name="UpdatedAtText" Style="{StaticResource IDFlyoutInfoTextStyle}" Grid.Row="1"/>

					<Border Style="{StaticResource IDFlyoutInfoBorderStyle}" Grid.Row="2">
						<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
							<TextBlock Text="Size"/>
							<wpf:FontIcon Margin="10,0,0,0" Text="&#xEE93;"/>
						</StackPanel>
					</Border>
					<TextBlock x:Name="SizeInfoText" Style="{StaticResource IDFlyoutInfoTextStyle}" Grid.Row="2"/>

					<Border Style="{StaticResource IDFlyoutInfoBorderStyle}" Grid.Row="3">
						<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
							<TextBlock Text="Approver ID"/>
							<wpf:FontIcon Margin="10,0,0,0" Text="&#xE2AF;"/>
						</StackPanel>
					</Border>
					<TextBlock x:Name="ApproverIdText" Style="{StaticResource IDFlyoutInfoTextStyle}" Grid.Row="3"/>

					<Border Style="{StaticResource IDFlyoutInfoBorderStyle}" Grid.Row="4">
						<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
							<TextBlock Text="Uploader ID"/>
							<wpf:FontIcon Margin="10,0,0,0" Text="&#xE898;"/>
						</StackPanel>
					</Border>
					<TextBlock x:Name="UploaderId" Style="{StaticResource IDFlyoutInfoTextStyle}" Grid.Row="4"/>

					<Grid Grid.Row="5" Grid.ColumnSpan="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="1.3*"/>
						</Grid.ColumnDefinitions>

						<Button x:Name="CopyUrlButton"
							Height="30"
							Margin="0,0,3,0"
							Padding="0"
							HorizontalAlignment="Stretch"
							Click="CopyUrlButton_Click">
							<StackPanel Orientation="Horizontal">
								<wpf:FontIcon Text="&#xE16F;"/>
								<TextBlock Margin="10,0,0,0" Text="Copy URL"/>
							</StackPanel>
						</Button>

						<Button x:Name="OpenBrowserButton"
							Grid.Column="1"
							Height="30"
							Margin="3,0,0,0"
							Padding="0"
							HorizontalAlignment="Stretch"
							Click="OpenBrowserButton_Click">
							<StackPanel Orientation="Horizontal">
								<wpf:FontIcon Text="&#xE12B;"/>
								<TextBlock Margin="10,0,0,0" Text="Open In Browser"/>
							</StackPanel>
						</Button>

					</Grid>

				</Grid>
			</Border>
		</wpf:ButtonPopup>

	</Grid>
</UserControl>
