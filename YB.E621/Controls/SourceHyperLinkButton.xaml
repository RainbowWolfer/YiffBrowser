<UserControl x:Name="Root"
	x:Class="YB.E621.Controls.SourceHyperLinkButton"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:DesignHeight="50"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<Control.Resources>

	</Control.Resources>

	<Grid DataContext="{Binding ElementName=Root}">

		<Button x:Name="MainButton"
			Padding="6,2"
			HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Left"
			BorderThickness="0"
			Background="Transparent"
			Click="MainButton_Click"
			Cursor="Hand">

			<DockPanel VerticalAlignment="Center">
				<wpf:ClippingBorder Margin="0,2,0,0" CornerRadius="4">
					<Image Height="20" VerticalAlignment="Center" Source="{Binding URL, Converter={StaticResource UrlIconConverter}}"/>
				</wpf:ClippingBorder>
				<TextBlock
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					Foreground="ForestGreen"
					Text="{Binding URL}"
					TextDecorations="Underline"
					TextTrimming="CharacterEllipsis"/>
			</DockPanel>

			<Button.ContextMenu>
				<ContextMenu>
					<MenuItem x:Name="CopyItem"
						bf:IconExtension.Glyph="&#xE8C8;"
						Click="CopyItem_Click"
						Header="Copy"/>
				</ContextMenu>
			</Button.ContextMenu>

		</Button>
	</Grid>
</UserControl>
