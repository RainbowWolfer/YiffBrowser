<UserControl x:Name="Root"
	x:Class="YB.E621.Controls.TagsListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:bf="BaseFramework"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:YB.E621.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DesignHeight="450"
	d:DesignWidth="200"
	mc:Ignorable="d">

	<Control.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/YB.E621;component/Resources/Generic.xaml"/>
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Control.Resources>

	<Grid>
		<ListBox x:Name="TagsistBox"
			Style="{StaticResource CustomListBoxStyle}"
			BorderThickness="0"
			bf:BorderExtension.CornerRadius="0"
			bf:ListBoxExtension.ClickBlankToDeselect="True"
			bf:ListBoxExtension.EscapeToDeselect="True"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			d:ItemsSource="{d:SampleData ItemCount=15}">

			<ListBox.GroupStyle>
				<GroupStyle>

					<GroupStyle.Panel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical"/>
						</ItemsPanelTemplate>
					</GroupStyle.Panel>

					<GroupStyle.ContainerStyle>
						<Style TargetType="{x:Type GroupItem}">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate>
										<Expander IsExpanded="True">
											<Expander.Header>
												<wpf:SpacingStackPanel Style="{StaticResource CustomHorizontalPanel}">
													<TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
													<TextBlock FontWeight="SemiBold" Text="{Binding Items.Count, StringFormat='{}({0})'}"/>
												</wpf:SpacingStackPanel>
											</Expander.Header>
											<ItemsPresenter/>
										</Expander>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</GroupStyle.ContainerStyle>

				</GroupStyle>
			</ListBox.GroupStyle>

			<ListBox.ItemTemplate>
				<DataTemplate>
					<Border>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="auto"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="1">
								<TextBlock Foreground="{Binding Category, Converter={StaticResource E621TagCategoryBrushConverter}}" Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
							</Border>

							<Button
								Grid.Column="2"
								BorderThickness="0"
								Background="Transparent"
								ToolTip="Search without this tag">
								<wpf:FontIcon FontSize="14" Text="&#xE949;"/>
							</Button>

							<Button
								Grid.Column="3"
								BorderThickness="0"
								Background="Transparent"
								ToolTip="Search with this tag">
								<wpf:FontIcon FontSize="14" Text="&#xE948;"/>
							</Button>

						</Grid>
					</Border>
				</DataTemplate>
			</ListBox.ItemTemplate>

			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem" BasedOn="{StaticResource CustomListBoxItemStyle}">
					<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
					<Setter Property="ContextMenu">
						<Setter.Value>
							<ContextMenu>
								<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail">
									<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
									<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
									<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail">
										<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
										<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
									</MenuItem>
								</MenuItem>
								<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
								<MenuItem bf:IconExtension.Glyph="&#xE8F6;" Header="Detail"/>
							</ContextMenu>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>

		</ListBox>

	</Grid>

</UserControl>
